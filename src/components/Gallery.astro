---
import type { PhotoEntry } from '../config/photo-manifest';
import { THUMB_SRCSET, photoSrcSet, photoVariant, ratioClass } from '../config/photos';
import { getLocale, getLocalizedCategories, getPhotoTitle, localizePath, useTranslations } from '../i18n';

interface Props {
  photos: PhotoEntry[];
  /**
   * This page's own category, when it has a single one (work/[category].astro passes its slug) —
   * the lightbox's "View <category> gallery" link's server-rendered default before any photo has
   * been opened (and its only possible value when `photos` is empty, so a category with none still
   * gets a real link rather than an unnamed one — features/html-quality.feature's accessible-name
   * check runs on the static build, never the client script below). A mixed gallery like the home
   * page's Featured strip has no single one to pass, so its default instead falls back to the first
   * photo's own category further down — accurate for as long as it takes the click handler in the
   * script below to point the link at whichever photo is actually open.
   */
  category?: string;
}

const { photos, category } = Astro.props;
const locale = getLocale(Astro);
const t = useTranslations(locale);

// A photo's own category isn't necessarily the page's (the home page's Featured strip mixes
// several), so the lightbox's "View <category> gallery" link needs every category's label, not
// just one — keyed by slug, for the client script below to look up whichever photo is open. Every
// category, not just the visible ones: a hidden category's own photos can still turn up in a
// gallery (e.g. a direct link into it), and the label should still resolve rather than show its slug.
const categoryLabels = Object.fromEntries(getLocalizedCategories(locale).map((c) => [c.slug, c.label]));

// The lightbox <img> has no photo until one is opened; a 1x1 transparent GIF keeps the HTML valid
// (an <img> needs a src) without a network request.
const BLANK_IMAGE = 'data:image/gif;base64,R0lGODlhAQABAAAAACH5BAEKAAEALAAAAAABAAEAAAICTAEAOw==';

// The first row is above the fold on most screens: load it right away, the rest lazily.
const EAGER_TILES = 3;

// Photos live in R2; the URLs are derived from each entry's photo id (no network at build time).
const tiles = photos.map((photo, index) => ({
  index,
  thumb: photoVariant(photo.data.photo, 'thumb'),
  srcset: photoSrcSet(photo.data.photo, THUMB_SRCSET),
  full: photoVariant(photo.data.photo, 'full'),
  category: photo.data.category,
  data: photo.data,
  title: getPhotoTitle(photo.data, locale),
  // The photo's own shape, from its real dimensions — not the (rounded) thumb's. Falls back to a
  // generic landscape shape if a photo somehow lacks real dimensions (problemWith() rejects that
  // at ingest, so this is only ever a defensive fallback).
  ratioClass: ratioClass(photo.data.photo.width && photo.data.photo.height ? photo.data.photo.width / photo.data.photo.height : 1.5),
}));

const defaultCategorySlug = category ?? tiles[0]?.category;
const defaultCategoryLabel = defaultCategorySlug ? (categoryLabels[defaultCategorySlug] ?? defaultCategorySlug) : undefined;
---

<div class="gallery">
  {tiles.map((tile) => (
    <button
      type="button"
      class:list={['tile', tile.ratioClass]}
      data-id={tile.data.photo.id}
      data-full={tile.full.src}
      data-caption={tile.title}
      data-title={tile.title}
      data-category={tile.category}
      data-camera={tile.data.camera ?? ''}
      data-placeholder={tile.data.placeholderColor ?? ''}
      aria-label={t('gallery.openPhoto', { title: tile.title })}
    >
      <img
        src={tile.thumb.src}
        width={tile.thumb.width}
        height={tile.thumb.height}
        srcset={tile.srcset}
        sizes="(max-width: 600px) 100vw, 350px"
        alt={tile.title}
        loading={tile.index < EAGER_TILES ? 'eager' : 'lazy'}
        fetchpriority={tile.index === 0 ? 'high' : undefined}
        decoding="async"
      />
      <span class="tile-caption">
        <span class="tile-title">{tile.title}</span>
        {tile.data.camera && (
          <span class="tile-meta">
            <span class="meta-row">{tile.data.camera}</span>
          </span>
        )}
      </span>
    </button>
  ))}
</div>

<div
  id="lightbox"
  class="lightbox"
  role="dialog"
  aria-modal="true"
  aria-labelledby="lightbox-caption"
  data-counter-template={t('gallery.counter')}
  data-category-labels={JSON.stringify(categoryLabels)}
  data-view-gallery-template={t('gallery.viewCategoryGallery')}
  hidden
>
  {/* Top-right, left of Close, in this order. Each is icon-only (no visible label, drawn in CSS —
      see the longer explanation by .lightbox-toolbar below); the accessible name comes entirely
      from aria-label, same as Close/Previous/Next always have. */}
  <div class="lightbox-toolbar">
    <button type="button" class="lightbox-tool lightbox-zoom-in" id="lightbox-zoom-in" aria-label={t('gallery.zoomIn')}>+</button>
    <button type="button" class="lightbox-tool lightbox-zoom-out" id="lightbox-zoom-out" aria-label={t('gallery.zoomOut')}>&minus;</button>
    {/* Its own icon flips (a CSS transform, not a swapped element) between this and .is-fullscreen;
        its label and aria-label are updated the same way, from the two data- attributes below,
        by the `fullscreenchange` listener in the script — the one event that reflects whether the
        browser actually entered fullscreen, rather than assuming the click that requested it succeeded.
        Hidden outright wherever `document.fullscreenEnabled` is false, so no dead button ships to a
        browser (or embedded context) that can't grant it. */}
    <button
      type="button"
      class="lightbox-tool lightbox-fullscreen"
      id="lightbox-fullscreen"
      aria-label={t('gallery.enterFullscreen')}
      data-enter-label={t('gallery.enterFullscreen')}
      data-exit-label={t('gallery.exitFullscreen')}
    ></button>
    {/* A real link (works with no JS, like the category page's own filter pills): server-rendered
        pointing at `defaultCategorySlug` (see the Props comment above), then kept in sync with
        whichever photo is actually open — not necessarily the same category, since the home page's
        Featured strip mixes several — by the script below, from `data-category-labels`/
        `data-view-gallery-template` above. */}
    <a
      class="lightbox-tool lightbox-view-gallery"
      id="lightbox-view-gallery"
      href={defaultCategorySlug ? localizePath(`/work/${defaultCategorySlug}/`, locale) : '#'}
      aria-label={defaultCategorySlug ? t('gallery.viewCategoryGallery', { category: defaultCategoryLabel ?? '' }) : undefined}
      data-astro-reload="false"
    ></a>
    <button type="button" class="lightbox-tool lightbox-close" id="lightbox-close" aria-label={t('gallery.close')}>&times;</button>
  </div>
  <button type="button" class="lightbox-nav lightbox-prev" id="lightbox-prev" aria-label={t('gallery.previous')}>&#8249;</button>
  <figure class="lightbox-figure">
    <img id="lightbox-img" alt="" src={BLANK_IMAGE} />
    <figcaption id="lightbox-caption">
      <span id="lightbox-title"></span><span id="lightbox-camera"></span>
    </figcaption>
  </figure>
  <p class="lightbox-counter" id="lightbox-counter" aria-hidden="true"></p>
  <button type="button" class="lightbox-nav lightbox-next" id="lightbox-next" aria-label={t('gallery.next')}>&#8250;</button>
</div>

<style is:global>
  /* Global, not Astro's default scoped CSS: the category page's client-side category switcher
     (work/[category].astro) rebuilds .gallery's tiles with document.createElement() when it swaps
     categories, and elements built that way never get the data-astro-cid attribute scoped CSS
     selectors require — every rule below would silently stop applying to a client-built tile (and,
     for the same reason, work/[category].astro's own <style> block is global too, for its pills and
     sort control). Every class/id name here is specific to this component (verified: nothing else
     in the site uses .gallery, .tile, .lightbox*, #lightbox-*, etc.), so nothing else can collide.
  */
  /* Justified-row gallery, in pure CSS: every tile gets its own photo's real aspect ratio
     (--tile-ratio, an inline style set server-side) at a shared row height, and flex-wrap breaks
     them into rows on its own. flex-grow then stretches each row's tiles to fill the leftover
     width. Two things keep that stretch from distorting a tile far enough that object-fit: cover
     crops away real content (a category with few photos — e.g. one landscape-oriented and one
     tall portrait-oriented photo sharing a row — used to stretch the narrow tile to several times
     its natural width while its height stayed fixed, cropping some 60%+ of the image and, for a
     portrait, often the subject's head): each ratio class's flex-grow is proportional to its own
     ratio (leftover space then scales every tile in the row by close to the same factor, the way a
     real justified-layout algorithm scales a whole row's height, rather than splitting it evenly
     regardless of each tile's own width), and max-width caps how far any single tile may stretch
     regardless of how few tiles share its row. A row that hits every one of its tiles' caps before
     filling the container's width just ends short of it (flex's own constraint-violation handling
     redistributes what a capped tile can't take, same as it does for min-width) — a little
     unfilled space at the end of a row reads fine; a cropped head does not.
     This needed no JavaScript specifically so it never resizes an already-rendered tile: an
     earlier version computed exact rows in a script, and even run as early as technically
     possible, that one-time resize was large enough to fail the layout-shift budget in
     features/browser/security-and-performance.feature. */
  .gallery {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .tile {
    position: relative;
    display: block;
    padding: 0;
    border: none;
    background: var(--bg-elevated);
    cursor: zoom-in;
    overflow: hidden;
    border-radius: var(--radius);
    --row-height: 260px;
    height: var(--row-height);
  }

  @media (max-width: 640px) {
    .tile {
      --row-height: 200px;
    }
  }

  /* One class per ratio bucket (a photo's width/height rounded to the nearest tenth — see
     ratioClass() in src/config/photos.ts): flex-basis is this tile's natural width at the row's
     current height, before flex-grow distributes any leftover row width across it and its
     row-mates; flex-grow proportional to the same ratio and max-width at 1.2x that width bound how
     much of that distortion any one tile can absorb (see the .gallery/.tile comment above). */
  .ratio-4 { flex-basis: calc(var(--row-height) * 0.4); flex-grow: 0.4; max-width: calc(var(--row-height) * 0.48); }
  .ratio-5 { flex-basis: calc(var(--row-height) * 0.5); flex-grow: 0.5; max-width: calc(var(--row-height) * 0.6); }
  .ratio-6 { flex-basis: calc(var(--row-height) * 0.6); flex-grow: 0.6; max-width: calc(var(--row-height) * 0.72); }
  .ratio-7 { flex-basis: calc(var(--row-height) * 0.7); flex-grow: 0.7; max-width: calc(var(--row-height) * 0.84); }
  .ratio-8 { flex-basis: calc(var(--row-height) * 0.8); flex-grow: 0.8; max-width: calc(var(--row-height) * 0.96); }
  .ratio-9 { flex-basis: calc(var(--row-height) * 0.9); flex-grow: 0.9; max-width: calc(var(--row-height) * 1.08); }
  .ratio-10 { flex-basis: calc(var(--row-height) * 1.0); flex-grow: 1.0; max-width: calc(var(--row-height) * 1.2); }
  .ratio-11 { flex-basis: calc(var(--row-height) * 1.1); flex-grow: 1.1; max-width: calc(var(--row-height) * 1.32); }
  .ratio-12 { flex-basis: calc(var(--row-height) * 1.2); flex-grow: 1.2; max-width: calc(var(--row-height) * 1.44); }
  .ratio-13 { flex-basis: calc(var(--row-height) * 1.3); flex-grow: 1.3; max-width: calc(var(--row-height) * 1.56); }
  .ratio-14 { flex-basis: calc(var(--row-height) * 1.4); flex-grow: 1.4; max-width: calc(var(--row-height) * 1.68); }
  .ratio-15 { flex-basis: calc(var(--row-height) * 1.5); flex-grow: 1.5; max-width: calc(var(--row-height) * 1.8); }
  .ratio-16 { flex-basis: calc(var(--row-height) * 1.6); flex-grow: 1.6; max-width: calc(var(--row-height) * 1.92); }
  .ratio-17 { flex-basis: calc(var(--row-height) * 1.7); flex-grow: 1.7; max-width: calc(var(--row-height) * 2.04); }
  .ratio-18 { flex-basis: calc(var(--row-height) * 1.8); flex-grow: 1.8; max-width: calc(var(--row-height) * 2.16); }
  .ratio-19 { flex-basis: calc(var(--row-height) * 1.9); flex-grow: 1.9; max-width: calc(var(--row-height) * 2.28); }
  .ratio-20 { flex-basis: calc(var(--row-height) * 2.0); flex-grow: 2.0; max-width: calc(var(--row-height) * 2.4); }
  .ratio-21 { flex-basis: calc(var(--row-height) * 2.1); flex-grow: 2.1; max-width: calc(var(--row-height) * 2.52); }
  .ratio-22 { flex-basis: calc(var(--row-height) * 2.2); flex-grow: 2.2; max-width: calc(var(--row-height) * 2.64); }
  .ratio-23 { flex-basis: calc(var(--row-height) * 2.3); flex-grow: 2.3; max-width: calc(var(--row-height) * 2.76); }
  .ratio-24 { flex-basis: calc(var(--row-height) * 2.4); flex-grow: 2.4; max-width: calc(var(--row-height) * 2.88); }
  .ratio-25 { flex-basis: calc(var(--row-height) * 2.5); flex-grow: 2.5; max-width: calc(var(--row-height) * 3.0); }
  .ratio-26 { flex-basis: calc(var(--row-height) * 2.6); flex-grow: 2.6; max-width: calc(var(--row-height) * 3.12); }

  .tile img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease, opacity 0.3s ease;
  }

  /* Blur-up stand-in: the tile's own background-color (its placeholderColor, applied by the script
     below from data-placeholder — not a server-rendered inline style, which the strict policy this
     site holds itself to, features/deployment.feature, forbids) shows through until the real
     thumbnail loads, instead of a flash of the plain tile background. The `.is-loading` class that
     hides the image is only ever added by the same script, never present by default, so a photo
     stays visible with no JS at all — nothing here can leave one permanently hidden. */
  .tile img.is-loading {
    opacity: 0;
  }

  .tile:hover img {
    transform: scale(1.04);
  }

  .tile-caption {
    position: absolute;
    inset: auto 0 0 0;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    padding: 0.6rem 0.8rem 0.7rem;
    font-size: 0.8rem;
    color: #fff;
    background: linear-gradient(to top, rgba(0, 0, 0, 0.85) 20%, transparent);
    text-align: left;
    opacity: 0;
    transform: translateY(4px);
    transition: opacity 0.2s ease, transform 0.2s ease;
    pointer-events: none;
  }

  .tile:hover .tile-caption,
  .tile:focus-visible .tile-caption {
    opacity: 1;
    transform: translateY(0);
  }

  .tile-title {
    font-weight: 600;
  }

  .tile-meta {
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
    font-size: 0.72rem;
    color: rgba(255, 255, 255, 0.8);
  }

  .meta-row {
    display: block;
  }

  .lightbox {
    position: fixed;
    inset: 0;
    z-index: 100;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: var(--space-1);
    background: rgba(6, 6, 7, 0.94);
    padding: var(--space-3);
  }

  .lightbox[hidden] {
    display: none;
  }

  .lightbox-figure {
    margin: 0;
    max-width: min(90vw, 1400px);
    max-height: 90vh;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-2);
  }

  .lightbox-figure img {
    max-width: 100%;
    max-height: 78vh;
    object-fit: contain;
    border-radius: var(--radius);
  }

  .lightbox-figure figcaption {
    color: var(--fg-muted);
    font-size: 0.9rem;
    text-align: center;
  }

  #lightbox-title {
    color: var(--fg);
  }

  #lightbox-camera {
    display: block;
    margin-top: 0.15rem;
    font-size: 0.8rem;
  }

  #lightbox-camera:empty {
    display: none;
  }

  .lightbox-counter {
    margin: 0;
    color: var(--fg-muted);
    font-size: 0.8rem;
    text-align: center;
  }

  .lightbox-nav {
    position: absolute;
    /* Without this, a *zoomed* photo (a `transform` on #lightbox-img — see setZoom() in the script
       below) promotes that image to its own stacking context, painted after (so on top of) any
       plain, non-positioned box in DOM order — including .lightbox-figure, which sits after these
       buttons in the markup. An explicit z-index sidesteps that entirely: these controls always
       paint above the photo, zoomed or not. */
    z-index: 1;
    background: none;
    border: none;
    color: #fff;
    font-size: 2.5rem;
    line-height: 1;
    cursor: pointer;
    padding: var(--space-1);
    opacity: 0.75;
    transition: opacity 0.2s ease;
  }

  .lightbox-nav:hover {
    opacity: 1;
  }

  /* Zoom in/out, (Enter/Exit) Fullscreen, View <category> gallery, then Close — in that order, top
     right. One row, so Close (which owned this corner alone before) just becomes its last, rightmost
     item; the group is still positioned as a unit the same way .lightbox-close used to be by itself. */
  .lightbox-toolbar {
    position: absolute;
    top: var(--space-2);
    right: var(--space-3);
    /* See the identical comment on .lightbox-nav above — a zoomed photo would otherwise paint over
       this toolbar too. */
    z-index: 1;
    display: flex;
    align-items: center;
    gap: 0.125rem;
  }

  .lightbox-tool {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    background: none;
    border: none;
    border-radius: var(--radius);
    /* #767676: the standard "equally accessible on either extreme" gray — ~4.5:1 contrast against
       both white and black, so an icon stays legible whether it lands over the near-black scrim,
       a dark part of the photo, or a light/white one (the toolbar sits *over* the photo, which can
       reach right up under it — see the .lightbox-tool z-index comment below). Full opacity, not
       dimmed at rest: dimming a color already chosen for a specific contrast ratio undoes the
       reason it was chosen, so hover is a background tint instead (below), not a brightness change.
    */
    color: #767676;
    font-size: 1.5rem;
    line-height: 1;
    text-decoration: none;
    cursor: pointer;
    transition: background-color 0.2s ease;
  }

  .lightbox-tool:hover {
    background: rgba(255, 255, 255, 0.15);
  }

  /* Real `disabled` (toggled by the script at the currentScale bounds it already enforces for
     pinch-zoom, not a new limit) rather than just leaving the button clickable but inert: it reads
     as unavailable, and drops out of the dialog's own Tab order the same way the script's focus
     trap already excludes anything else `:disabled`/`[hidden]`. */
  .lightbox-tool:disabled {
    opacity: 0.3;
    cursor: default;
  }

  .lightbox-close {
    font-size: 2rem;
  }

  /* Two opposite corner brackets — ⌜ top-left, ⌟ bottom-right — the same "expand to fill the
     screen" shape used everywhere from video players to OS window controls, drawn in CSS rather
     than as a Unicode glyph (no single character renders it reliably across fonts) or an SVG (this
     codebase ships none — see the hamburger icon this same trick is borrowed from in Header.astro).
     .is-fullscreen (set by the script from the real `fullscreenchange` event) rotates both 180°
     in place, which turns the same two corners inward into a "shrink back down" shape — one pair of
     shapes, not a second icon to keep in sync. */
  .lightbox-fullscreen {
    position: relative;
  }

  .lightbox-fullscreen::before,
  .lightbox-fullscreen::after {
    content: '';
    position: absolute;
    width: 9px;
    height: 9px;
    border: 2px solid currentColor;
    transition: transform 0.2s ease;
  }

  .lightbox-fullscreen::before {
    top: 9px;
    left: 9px;
    border-right: none;
    border-bottom: none;
  }

  .lightbox-fullscreen::after {
    bottom: 9px;
    right: 9px;
    border-left: none;
    border-top: none;
  }

  .lightbox-fullscreen.is-fullscreen::before,
  .lightbox-fullscreen.is-fullscreen::after {
    transform: rotate(180deg);
  }

  /* A 2x2 grid of squares (the standard "grid view" icon) from one pseudo-element and its own
     box-shadow, the same one-element-no-SVG approach as the fullscreen icon above: the element
     itself is the top-left square, and three more box-shadows (no blur, no spread beyond their
     offset) paint the other three without adding any markup for them. */
  .lightbox-view-gallery {
    position: relative;
  }

  .lightbox-view-gallery::before {
    content: '';
    position: absolute;
    top: 13px;
    left: 13px;
    width: 6px;
    height: 6px;
    background: currentColor;
    box-shadow: 9px 0 0 currentColor, 0 9px 0 currentColor, 9px 9px 0 currentColor;
  }

  .lightbox-prev {
    left: var(--space-2);
    top: 50%;
    transform: translateY(-50%);
  }

  .lightbox-next {
    right: var(--space-2);
    top: 50%;
    transform: translateY(-50%);
  }

  @media (max-width: 640px) {
    .lightbox-nav {
      font-size: 2rem;
    }

    .lightbox-tool {
      width: 36px;
      height: 36px;
    }
  }
</style>

<script>
  import { DEFAULT_LOCALE } from '../i18n/config';

  // Astro bundles this script to one stable URL shared by every gallery-bearing page, so the
  // browser's module cache only ever evaluates it once per tab — a direct top-level call here
  // would only ever wire up the very first gallery seen. `astro:page-load` fires again on every
  // later view-transition navigation (and once for the very first load too, via the native `load`
  // event), each time against that page's own fresh tiles/lightbox, so re-querying and
  // re-attaching on every firing is what keeps the gallery working after a client-routed
  // navigation. See Header.astro's script for the fuller explanation.
  // The URL holds the open photo's id as ?photo=<id> (deep-linkable and shareable), synced both
  // ways: opening pushes/replaces it, and a page loaded with it already set (including a fresh
  // load, before any click) opens straight to that photo. This never goes through Astro's own
  // navigate() — the whole point is to stay on this page, not fetch/swap it — so it manipulates
  // `history` directly instead, always with a `null` state. Astro's own popstate handler explicitly
  // ignores a `null` state (its documented way of marking a history entry it doesn't own), so this
  // never confuses its separate index-based bookkeeping for real page-to-page transitions.
  const PHOTO_PARAM = 'photo';

  function urlWithPhoto(id: string | null): string {
    const url = new URL(location.href);
    if (id) url.searchParams.set(PHOTO_PARAM, id);
    else url.searchParams.delete(PHOTO_PARAM);
    return `${url.pathname}${url.search}${url.hash}`;
  }

  // A tiny copy of i18n's own localizePath(), not an import — see work/[category].astro's client
  // script, which needs the identical one-liner for the identical reason (bytes).
  const localizePath = (path: string, locale: string) => (locale === DEFAULT_LOCALE ? path : `/${locale}${path}`);

  // --- Blur-up placeholder: each tile's background-color (its placeholderColor, from
  // data-placeholder — not a server-rendered inline style, which the strict policy this site holds
  // itself to, features/deployment.feature, forbids) shows through until its thumbnail has
  // actually loaded. Setting it here, and the `.is-loading` class that hides the image, are both
  // paint-only changes (never affecting layout), so — unlike a resize — there's no ordering
  // constraint tying this to before-first-paint; and the `.is-loading` class is only ever added
  // here, never present in the server-rendered HTML, so a photo stays visible with no JS at all.
  function initPlaceholders(root: Document | HTMLElement) {
    for (const tile of Array.from(root.querySelectorAll<HTMLElement>('.tile'))) {
      if (tile.dataset.placeholder) tile.style.backgroundColor = tile.dataset.placeholder;
      const img = tile.querySelector('img');
      if (!img || img.complete) continue;
      img.classList.add('is-loading');
      img.addEventListener('load', () => img.classList.remove('is-loading'), { once: true });
    }
  }

  let removeKeydown: (() => void) | null = null;
  let removePopstate: (() => void) | null = null;
  let removeFullscreenChange: (() => void) | null = null;

  function initGallery(root: Document | HTMLElement) {
    // `document`/`window` persist across transitions; without removing the previous page's
    // handlers first, each navigation would stack another one that still (harmlessly, but
    // wastefully) matches against whichever lightbox is currently live — worse, a stacked
    // Escape/Arrow handler would fire once per navigation visited so far, advancing the photo more
    // than one step per key.
    removeKeydown?.();
    removeKeydown = null;
    removePopstate?.();
    removePopstate = null;
    removeFullscreenChange?.();
    removeFullscreenChange = null;

    const tiles = Array.from(root.querySelectorAll<HTMLButtonElement>('.tile'));
    if (!tiles.length) return;

    const lightbox = document.getElementById('lightbox') as HTMLDivElement | null;
    const img = document.getElementById('lightbox-img') as HTMLImageElement | null;
    const titleEl = document.getElementById('lightbox-title');
    const cameraEl = document.getElementById('lightbox-camera');
    const counterEl = document.getElementById('lightbox-counter');
    const closeBtn = document.getElementById('lightbox-close');
    const prevBtn = document.getElementById('lightbox-prev');
    const nextBtn = document.getElementById('lightbox-next');
    const zoomInBtn = document.getElementById('lightbox-zoom-in') as HTMLButtonElement | null;
    const zoomOutBtn = document.getElementById('lightbox-zoom-out') as HTMLButtonElement | null;
    const fullscreenBtn = document.getElementById('lightbox-fullscreen') as HTMLButtonElement | null;
    const viewGalleryLink = document.getElementById('lightbox-view-gallery') as HTMLAnchorElement | null;
    const figure = lightbox?.querySelector('.lightbox-figure') as HTMLElement | null;
    if (!lightbox || !img || !titleEl || !cameraEl) return;

    const counterTemplate = lightbox.dataset.counterTemplate ?? '';
    const viewGalleryTemplate = lightbox.dataset.viewGalleryTemplate ?? '{category}';
    const categoryLabels: Record<string, string> = JSON.parse(lightbox.dataset.categoryLabels ?? '{}');
    const locale = document.documentElement.lang || DEFAULT_LOCALE;
    const ZOOM_STEP = 0.5;
    const ZOOM_MAX = 4;
    let currentIndex = 0;
    let currentScale = 1;
    let lastFocused: HTMLElement | null = null;

    // Shared by the zoom in/out buttons and pinch-to-zoom (see the touch handlers below) so both
    // ways of zooming keep the buttons' `disabled` state in sync with the bounds they already
    // impose on pinch alone.
    function setZoom(scale: number) {
      currentScale = Math.min(ZOOM_MAX, Math.max(1, scale));
      img!.style.transform = currentScale > 1 ? `scale(${currentScale})` : '';
      if (zoomInBtn) zoomInBtn.disabled = currentScale >= ZOOM_MAX;
      if (zoomOutBtn) zoomOutBtn.disabled = currentScale <= 1;
    }

    function resetZoom() {
      setZoom(1);
    }

    // The one source of truth for whether fullscreen is actually on: `fullscreenchange` fires
    // whether it was this button that triggered it, the browser denying the request, or the user
    // leaving fullscreen some other way (Esc, browser chrome) — including the lightbox's own
    // `hidden` (display: none) closing it, which the browser treats as leaving fullscreen on its
    // own, so closing the dialog while fullscreen needs no extra handling here.
    function updateFullscreenButton() {
      if (!fullscreenBtn) return;
      const isFullscreen = document.fullscreenElement === lightbox;
      fullscreenBtn.classList.toggle('is-fullscreen', isFullscreen);
      fullscreenBtn.setAttribute('aria-label', (isFullscreen ? fullscreenBtn.dataset.exitLabel : fullscreenBtn.dataset.enterLabel) ?? '');
    }

    // `history` mode: 'push' for a fresh open (a new dialog interaction worth a Back step),
    // 'replace' for moving to a different photo while already open (so Back doesn't step through
    // every photo visited), 'none' when only syncing the UI to a URL that's already correct
    // (initial load, or reacting to the browser's own back/forward).
    function show(index: number, history_: 'push' | 'replace' | 'none') {
      const total = tiles.length;
      currentIndex = (index + total) % total;
      const tile = tiles[currentIndex];
      img!.src = tile.dataset.full ?? '';
      img!.alt = tile.dataset.title ?? '';
      titleEl!.textContent = tile.dataset.caption ?? '';
      cameraEl!.textContent = tile.dataset.camera ? ` — ${tile.dataset.camera}` : '';
      if (counterEl) counterEl.textContent = counterTemplate.replace('{current}', String(currentIndex + 1)).replace('{total}', String(total));
      // The open photo's own category, not necessarily the page's — the home page's Featured strip
      // mixes several, so this is read fresh off the tile on every photo switch, not computed once.
      const categorySlug = tile.dataset.category;
      if (viewGalleryLink && categorySlug) {
        viewGalleryLink.href = localizePath(`/work/${categorySlug}/`, locale);
        viewGalleryLink.setAttribute('aria-label', viewGalleryTemplate.replace('{category}', categoryLabels[categorySlug] ?? categorySlug));
      }
      resetZoom();
      if (history_ === 'push') history.pushState(null, '', urlWithPhoto(tile.dataset.id ?? null));
      else if (history_ === 'replace') history.replaceState(null, '', urlWithPhoto(tile.dataset.id ?? null));
    }

    function open(index: number, history_: 'push' | 'none') {
      lastFocused = document.activeElement as HTMLElement;
      show(index, history_);
      lightbox!.hidden = false;
      document.body.style.overflow = 'hidden';
      closeBtn?.focus();
    }

    function close(history_: 'replace' | 'none') {
      lightbox!.hidden = true;
      document.body.style.overflow = '';
      lastFocused?.focus();
      if (history_ === 'replace') history.replaceState(null, '', urlWithPhoto(null));
    }

    // Reacts to the browser's own Back/Forward buttons: the URL has already changed by the time
    // this fires, so this only ever syncs the UI to match it, never touches `history` itself.
    function syncToUrl() {
      const id = new URLSearchParams(location.search).get(PHOTO_PARAM);
      const index = id ? tiles.findIndex((tile) => tile.dataset.id === id) : -1;
      if (index >= 0) {
        if (lightbox!.hidden) open(index, 'none');
        else show(index, 'none');
      } else if (!lightbox!.hidden) {
        close('none');
      }
    }

    tiles.forEach((tile, index) => {
      tile.addEventListener('click', () => open(index, 'push'));
    });

    closeBtn?.addEventListener('click', () => close('replace'));
    prevBtn?.addEventListener('click', () => show(currentIndex - 1, 'replace'));
    nextBtn?.addEventListener('click', () => show(currentIndex + 1, 'replace'));
    zoomInBtn?.addEventListener('click', () => setZoom(currentScale + ZOOM_STEP));
    zoomOutBtn?.addEventListener('click', () => setZoom(currentScale - ZOOM_STEP));

    // Hidden outright, not just left to fail on click, wherever the browser can't grant it at all
    // (an older browser, or an embedded context that denies it) — see the CSS comment on
    // .lightbox-fullscreen for why the icon itself needs no separate "unsupported" state.
    if (fullscreenBtn) {
      if (!document.fullscreenEnabled) {
        fullscreenBtn.hidden = true;
      } else {
        fullscreenBtn.addEventListener('click', () => {
          if (document.fullscreenElement === lightbox) document.exitFullscreen();
          // Rejected quietly (e.g. denied outside a user gesture): updateFullscreenButton(), driven
          // only by the real fullscreenchange event below, simply never fires, so the button stays
          // exactly as it was — never a click that visibly does nothing but also throws.
          else lightbox.requestFullscreen().catch(() => {});
        });
        document.addEventListener('fullscreenchange', updateFullscreenButton);
        removeFullscreenChange = () => document.removeEventListener('fullscreenchange', updateFullscreenButton);
      }
    }

    lightbox.addEventListener('click', (event) => {
      if (event.target === lightbox) close('replace');
    });

    const onKeydown = (event: KeyboardEvent) => {
      if (lightbox.hidden) return;
      if (event.key === 'Escape') close('replace');
      if (event.key === 'ArrowLeft') show(currentIndex - 1, 'replace');
      if (event.key === 'ArrowRight') show(currentIndex + 1, 'replace');

      if (event.key === 'Tab') {
        // Queried live, not a fixed list: which buttons are focusable changes at runtime (zoom
        // buttons disable at their bounds, the fullscreen button hides itself when unsupported —
        // see above), and the trap must always match exactly what Tab can actually reach.
        const focusable = Array.from(lightbox.querySelectorAll<HTMLElement>('button:not([hidden]):not(:disabled), a[href]'));
        if (!focusable.length) return;
        const first = focusable[0];
        const last = focusable[focusable.length - 1];
        if (event.shiftKey && document.activeElement === first) {
          event.preventDefault();
          last.focus();
        } else if (!event.shiftKey && document.activeElement === last) {
          event.preventDefault();
          first.focus();
        }
      }
    };
    document.addEventListener('keydown', onKeydown);
    removeKeydown = () => document.removeEventListener('keydown', onKeydown);

    window.addEventListener('popstate', syncToUrl);
    removePopstate = () => window.removeEventListener('popstate', syncToUrl);

    // --- touch: swipe left/right between photos, pinch to zoom the open photo -------------------
    let gesture: 'swipe' | 'pinch' | 'none' = 'none';
    let swipeStartX = 0;
    let swipeStartY = 0;
    let pinchStartDistance = 0;

    const touchDistance = (a: Touch, b: Touch) => Math.hypot(a.clientX - b.clientX, a.clientY - b.clientY);

    figure?.addEventListener('touchstart', (event) => {
      if (event.touches.length === 2) {
        gesture = 'pinch';
        pinchStartDistance = touchDistance(event.touches[0], event.touches[1]);
      } else if (event.touches.length === 1 && currentScale <= 1) {
        gesture = 'swipe';
        swipeStartX = event.touches[0].clientX;
        swipeStartY = event.touches[0].clientY;
      } else {
        gesture = 'none';
      }
    }, { passive: true });

    figure?.addEventListener('touchmove', (event) => {
      if (gesture !== 'pinch' || event.touches.length !== 2) return;
      // Stops the whole page from also pinch-zooming while the photo does.
      event.preventDefault();
      const scale = touchDistance(event.touches[0], event.touches[1]) / pinchStartDistance;
      setZoom(scale);
    }, { passive: false });

    figure?.addEventListener('touchend', (event) => {
      if (gesture === 'swipe' && event.changedTouches.length === 1) {
        const dx = event.changedTouches[0].clientX - swipeStartX;
        const dy = event.changedTouches[0].clientY - swipeStartY;
        // Mostly horizontal and far enough to be a deliberate swipe, not an incidental wobble.
        if (Math.abs(dx) > 50 && Math.abs(dx) > Math.abs(dy) * 1.5) show(currentIndex + (dx < 0 ? 1 : -1), 'replace');
      }
      if (event.touches.length === 0) gesture = 'none';
    });

    // A page freshly loaded (or arrived at via a client-routed transition) with ?photo=<id>
    // already in its URL opens straight to that photo — including with JS present but before any
    // click, since this runs as part of the same initGallery() call that wires up the tiles above.
    syncToUrl();
  }

  // Run immediately — as soon as this module evaluates, which for a deferred module script is
  // right after the DOM finishes parsing — rather than waiting only for astro:page-load, which for
  // this, the very first page, doesn't fire until the native `load` event: after every image has
  // already finished downloading. Waiting that long would mean every image is already `.complete`
  // by the time initPlaceholders looks, so the fade-in-from-placeholder-color would never actually
  // show on a first visit. It's idempotent, so also running it again below for every later
  // view-transition navigation (where this direct call, part of a script that only evaluates once
  // per tab, never fires a second time) is harmless.
  initPlaceholders(document);

  document.addEventListener('astro:page-load', () => {
    initGallery(document);
    initPlaceholders(document);
  });

  // The category page's client-side category switcher (Phase 6) replaces .gallery's contents with
  // freshly built tiles for a different category, entirely on its own — Gallery.astro's own script
  // has no way to know that happened by itself. It announces it with this event instead of reaching
  // into this module's internals directly, so the two stay decoupled the same way this file and the
  // page using it always have been: this is the one thing it needs from the outside, and this is
  // the one thing it exposes for it.
  document.addEventListener('gallery:refresh', () => {
    initGallery(document);
    initPlaceholders(document);
  });
</script>
