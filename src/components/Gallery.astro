---
import type { CollectionEntry } from 'astro:content';
import { photoVariant } from '../config/photos';
import { getLocale, getPhotoTitle, useTranslations } from '../i18n';

interface Props {
  photos: CollectionEntry<'photos'>[];
}

const { photos } = Astro.props;
const locale = getLocale(Astro);
const t = useTranslations(locale);

// Photos live in R2; the URLs are derived from each entry's photo id (no network at build time).
const tiles = photos.map((photo, index) => ({
  index,
  thumb: photoVariant(photo.data.photo, 'thumb'),
  full: photoVariant(photo.data.photo, 'full'),
  data: photo.data,
  title: getPhotoTitle(photo.data, locale),
}));
---

<div class="gallery">
  {tiles.map((tile) => (
    <button
      type="button"
      class="tile"
      data-full={tile.full.src}
      data-caption={tile.title}
      data-title={tile.title}
      aria-label={t('gallery.openPhoto', { title: tile.title })}
    >
      <img
        src={tile.thumb.src}
        width={tile.thumb.width}
        height={tile.thumb.height}
        alt={tile.title}
        loading="lazy"
        decoding="async"
      />
      <span class="tile-caption">
        <span class="tile-title">{tile.title}</span>
        {tile.data.camera && (
          <span class="tile-meta">
            <span class="meta-row">{tile.data.camera}</span>
          </span>
        )}
      </span>
    </button>
  ))}
</div>

<div
  id="lightbox"
  class="lightbox"
  role="dialog"
  aria-modal="true"
  aria-labelledby="lightbox-caption"
  hidden
>
  <button type="button" class="lightbox-close" id="lightbox-close" aria-label={t('gallery.close')}>&times;</button>
  <button type="button" class="lightbox-nav lightbox-prev" id="lightbox-prev" aria-label={t('gallery.previous')}>&#8249;</button>
  <figure class="lightbox-figure">
    <img id="lightbox-img" alt="" />
    <figcaption id="lightbox-caption"></figcaption>
  </figure>
  <button type="button" class="lightbox-nav lightbox-next" id="lightbox-next" aria-label={t('gallery.next')}>&#8250;</button>
</div>

<style>
  .gallery {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: var(--space-2);
  }

  .tile {
    position: relative;
    display: block;
    padding: 0;
    border: none;
    background: var(--bg-elevated);
    cursor: zoom-in;
    aspect-ratio: 3 / 2;
    overflow: hidden;
    border-radius: var(--radius);
  }

  .tile img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease;
  }

  .tile:hover img {
    transform: scale(1.04);
  }

  .tile-caption {
    position: absolute;
    inset: auto 0 0 0;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    padding: 0.6rem 0.8rem 0.7rem;
    font-size: 0.8rem;
    color: #fff;
    background: linear-gradient(to top, rgba(0, 0, 0, 0.85) 20%, transparent);
    text-align: left;
    opacity: 0;
    transform: translateY(4px);
    transition: opacity 0.2s ease, transform 0.2s ease;
    pointer-events: none;
  }

  .tile:hover .tile-caption,
  .tile:focus-visible .tile-caption {
    opacity: 1;
    transform: translateY(0);
  }

  .tile-title {
    font-weight: 600;
  }

  .tile-meta {
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
    font-size: 0.72rem;
    color: rgba(255, 255, 255, 0.8);
  }

  .meta-row {
    display: block;
  }

  .lightbox {
    position: fixed;
    inset: 0;
    z-index: 100;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(6, 6, 7, 0.94);
    padding: var(--space-3);
  }

  .lightbox[hidden] {
    display: none;
  }

  .lightbox-figure {
    margin: 0;
    max-width: min(90vw, 1400px);
    max-height: 90vh;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-2);
  }

  .lightbox-figure img {
    max-width: 100%;
    max-height: 78vh;
    object-fit: contain;
    border-radius: var(--radius);
  }

  .lightbox-figure figcaption {
    color: var(--fg-muted);
    font-size: 0.9rem;
    text-align: center;
  }

  .lightbox-close,
  .lightbox-nav {
    position: absolute;
    background: none;
    border: none;
    color: #fff;
    font-size: 2.5rem;
    line-height: 1;
    cursor: pointer;
    padding: var(--space-1);
    opacity: 0.75;
    transition: opacity 0.2s ease;
  }

  .lightbox-close:hover,
  .lightbox-nav:hover {
    opacity: 1;
  }

  .lightbox-close {
    top: var(--space-2);
    right: var(--space-3);
    font-size: 2rem;
  }

  .lightbox-prev {
    left: var(--space-2);
    top: 50%;
    transform: translateY(-50%);
  }

  .lightbox-next {
    right: var(--space-2);
    top: 50%;
    transform: translateY(-50%);
  }

  @media (max-width: 640px) {
    .lightbox-nav {
      font-size: 2rem;
    }
  }
</style>

<script>
  function initGallery(root: Document | HTMLElement) {
    const tiles = Array.from(root.querySelectorAll<HTMLButtonElement>('.tile'));
    if (!tiles.length) return;

    const lightbox = document.getElementById('lightbox') as HTMLDivElement | null;
    const img = document.getElementById('lightbox-img') as HTMLImageElement | null;
    const caption = document.getElementById('lightbox-caption');
    const closeBtn = document.getElementById('lightbox-close');
    const prevBtn = document.getElementById('lightbox-prev');
    const nextBtn = document.getElementById('lightbox-next');
    if (!lightbox || !img || !caption) return;

    let currentIndex = 0;
    let lastFocused: HTMLElement | null = null;

    function show(index: number) {
      const total = tiles.length;
      currentIndex = (index + total) % total;
      const tile = tiles[currentIndex];
      img!.src = tile.dataset.full ?? '';
      img!.alt = tile.dataset.title ?? '';
      caption!.textContent = tile.dataset.caption ?? '';
    }

    function open(index: number) {
      lastFocused = document.activeElement as HTMLElement;
      show(index);
      lightbox!.hidden = false;
      document.body.style.overflow = 'hidden';
      closeBtn?.focus();
    }

    function close() {
      lightbox!.hidden = true;
      document.body.style.overflow = '';
      lastFocused?.focus();
    }

    tiles.forEach((tile, index) => {
      tile.addEventListener('click', () => open(index));
    });

    closeBtn?.addEventListener('click', close);
    prevBtn?.addEventListener('click', () => show(currentIndex - 1));
    nextBtn?.addEventListener('click', () => show(currentIndex + 1));

    lightbox.addEventListener('click', (event) => {
      if (event.target === lightbox) close();
    });

    document.addEventListener('keydown', (event) => {
      if (lightbox.hidden) return;
      if (event.key === 'Escape') close();
      if (event.key === 'ArrowLeft') show(currentIndex - 1);
      if (event.key === 'ArrowRight') show(currentIndex + 1);

      if (event.key === 'Tab') {
        const focusable = [closeBtn, prevBtn, nextBtn].filter(
          (el): el is HTMLButtonElement => el !== null
        );
        if (!focusable.length) return;
        const first = focusable[0];
        const last = focusable[focusable.length - 1];
        if (event.shiftKey && document.activeElement === first) {
          event.preventDefault();
          last.focus();
        } else if (!event.shiftKey && document.activeElement === last) {
          event.preventDefault();
          first.focus();
        }
      }
    });
  }

  initGallery(document);
  document.addEventListener('astro:page-load', () => initGallery(document));
</script>
