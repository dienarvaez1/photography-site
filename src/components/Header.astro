---
import { SITE } from '../config/site';
import {
  LOCALE_INFO,
  getAlternates,
  getLocale,
  getSortedVisibleCategories,
  localizePath,
  splitLocalePath,
  useTranslations,
} from '../i18n';

const locale = getLocale(Astro);
const t = useTranslations(locale);

// Compare against the locale-less path so "active" works the same in every language.
const currentPath = splitLocalePath(Astro.url.pathname).path.replace(/\/+$/, '') || '/';
const sortedCategories = getSortedVisibleCategories(locale);
const alternates = getAlternates(Astro.url.pathname);
---

<header class="site-header">
  <div class="wrap bar">
    <a href={localizePath('/', locale)} class="brand">
      <img src="/logo.png" alt={SITE.author} class="brand-logo" />
      <img src="/aperture-logo.png" alt="" class="aperture-logo" />
    </a>

    <button class="nav-toggle" aria-expanded="false" aria-controls="primary-nav" id="nav-toggle">
      <span class="visually-hidden">{t('nav.toggleNavigation')}</span>
      <span class="nav-toggle-icon"></span>
    </button>

    <nav id="primary-nav" class="primary-nav">
      <div class="nav-group">
        <button
          type="button"
          class="nav-label"
          id="nav-work-toggle"
          aria-expanded="false"
          aria-controls="nav-work-dropdown"
        >
          {t('nav.work')}
        </button>
        <div class="nav-dropdown" id="nav-work-dropdown">
          {sortedCategories.map((c) => (
            <a
              href={localizePath(`/work/${c.slug}/`, locale)}
              class:list={{ active: currentPath === `/work/${c.slug}` }}
            >
              {c.label}
            </a>
          ))}
        </div>
      </div>
      <a href={localizePath('/about/', locale)} class:list={{ active: currentPath === '/about' }}>
        {t('nav.about')}
      </a>
      <a href={localizePath('/contact/', locale)} class:list={{ active: currentPath === '/contact' }}>
        {t('nav.contact')}
      </a>
      <div class="lang-switcher" role="group" aria-label={t('nav.language')}>
        {alternates.map((alt) =>
          alt.current ? (
            <span class="lang-current" lang={alt.locale} aria-current="true" title={LOCALE_INFO[alt.locale].name}>
              {LOCALE_INFO[alt.locale].short}
            </span>
          ) : (
            <a
              href={alt.path}
              lang={alt.locale}
              hreflang={alt.locale}
              title={LOCALE_INFO[alt.locale].name}
              aria-label={LOCALE_INFO[alt.locale].name}
            >
              {LOCALE_INFO[alt.locale].short}
            </a>
          )
        )}
      </div>
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 40;
    background: rgba(11, 12, 14, 0.85);
    -webkit-backdrop-filter: blur(8px);
    backdrop-filter: blur(8px);
    border-bottom: 1px solid var(--border);
  }

  .bar {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    padding-block: var(--space-2);
  }

  .brand {
    grid-column: 2;
    justify-self: center;
    display: flex;
    align-items: center;
    gap: 0.75rem;
    text-decoration: none;
  }

  .brand-logo {
    height: 5.0625rem;
    width: auto;
    display: block;
  }

  .aperture-logo {
    height: 3.4rem;
    width: auto;
    display: block;
  }

  .primary-nav {
    grid-column: 3;
    justify-self: end;
    display: flex;
    align-items: center;
    gap: var(--space-4);
  }

  .primary-nav > a {
    text-decoration: none;
    font-size: 1.0rem;
    color: var(--fg-muted);
    transition: color 0.2s ease;
  }

  .primary-nav > a:hover,
  .primary-nav > a.active {
    color: var(--fg);
  }

  .lang-switcher {
    --lang-switch: #ffe600;
    --lang-switch-hover: #fff27a;
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding-left: var(--space-3);
    border-left: 1px solid var(--border);
    font-size: 0.85rem;
    letter-spacing: 0.05em;
  }

  .lang-switcher a {
    text-decoration: none;
    color: var(--lang-switch);
    transition: color 0.2s ease;
  }

  .lang-switcher a:hover {
    color: var(--lang-switch-hover);
  }

  /* Same yellow as the link; bold + underline marks the active language. */
  .lang-current {
    color: var(--lang-switch);
    font-weight: 700;
    text-decoration: underline;
    text-underline-offset: 0.25em;
  }

  .nav-group {
    position: relative;
  }

  .nav-label {
    background: none;
    border: none;
    font: inherit;
    padding: 0;
    cursor: pointer;
    font-size: 1.0rem;
    color: var(--fg-muted);
  }

  .nav-dropdown {
    position: absolute;
    top: 100%;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    flex-direction: column;
    min-width: 180px;
    padding: var(--space-1);
    margin-top: var(--space-2);
    background: var(--bg-elevated);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    opacity: 0;
    /* Kept focusable (not visibility:hidden) so keyboard users tabbing
       to these links triggers :focus-within below and reveals them —
       matching what mouse users get on :hover. */
    pointer-events: none;
    transform-origin: top center;
    transition: opacity 0.15s ease;
  }

  .nav-group:hover .nav-dropdown,
  .nav-group:focus-within .nav-dropdown {
    opacity: 1;
    pointer-events: auto;
  }

  .nav-dropdown a {
    padding: 0.7rem 0.75rem;
    text-decoration: none;
    font-size: 0.85rem;
    color: var(--fg-muted);
    border-radius: var(--radius);
    white-space: nowrap;
  }

  .nav-dropdown a:hover,
  .nav-dropdown a.active {
    color: var(--fg);
    background: rgba(255, 255, 255, 0.04);
  }

  .nav-toggle {
    grid-column: 3;
    justify-self: end;
    display: none;
    align-items: center;
    justify-content: center;
    min-width: 44px;
    min-height: 44px;
    background: none;
    border: none;
    color: var(--fg);
    padding: 0.5rem;
    cursor: pointer;
  }

  .nav-toggle-icon,
  .nav-toggle-icon::before,
  .nav-toggle-icon::after {
    display: block;
    width: 22px;
    height: 2px;
    background: currentColor;
    position: relative;
    transition: transform 0.2s ease;
  }

  .nav-toggle-icon::before,
  .nav-toggle-icon::after {
    content: '';
    position: absolute;
  }

  .nav-toggle-icon::before {
    top: -7px;
  }

  .nav-toggle-icon::after {
    top: 7px;
  }

  @media (max-width: 720px) {
    .brand-logo {
      height: 2.75rem;
    }

    .aperture-logo {
      height: 1.85rem;
    }

    .nav-toggle {
      display: flex;
    }

    .primary-nav {
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      flex-direction: column;
      align-items: stretch;
      gap: 0;
      background: var(--bg-elevated);
      border-bottom: 1px solid var(--border);
      max-height: 0;
      overflow: hidden;
      transition: max-height 0.25s ease;
    }

    .primary-nav.open {
      max-height: 560px;
    }

    .primary-nav > a {
      padding: var(--space-2) var(--space-3);
      border-top: 1px solid var(--border);
    }

    .nav-group {
      padding: var(--space-2) var(--space-3);
      border-top: 1px solid var(--border);
    }

    .lang-switcher {
      padding: var(--space-2) var(--space-3);
      border-left: none;
      border-top: 1px solid var(--border);
    }

    .nav-dropdown {
      position: static;
      transform: none;
      opacity: 1;
      /* Mobile shows/hides via the .open class (JS), not hover/focus,
         so it must stay clickable regardless of focus state. */
      pointer-events: auto;
      display: none;
      border: none;
      background: none;
      margin-top: var(--space-1);
      padding: 0;
    }

    .nav-group.open .nav-dropdown {
      display: flex;
    }
  }
</style>

<script>
  import { storeLocale } from '../i18n/geo.ts';

  const toggle = document.getElementById('nav-toggle');
  const nav = document.getElementById('primary-nav');
  const navGroup = nav?.querySelector('.nav-group');
  const navLabel = navGroup?.querySelector('.nav-label');

  toggle?.addEventListener('click', () => {
    const isOpen = nav?.classList.toggle('open');
    toggle.setAttribute('aria-expanded', String(Boolean(isOpen)));
  });

  navLabel?.addEventListener('click', () => {
    if (window.innerWidth <= 720) {
      const isOpen = navGroup?.classList.toggle('open');
      navLabel.setAttribute('aria-expanded', String(Boolean(isOpen)));
    }
  });

  // Clicking the language switcher is an explicit choice: remember it so the
  // location-based default on the home page never overrides it.
  document.querySelectorAll<HTMLAnchorElement>('.lang-switcher a[hreflang]').forEach((link) => {
    link.addEventListener('click', () => {
      try {
        storeLocale(window.localStorage, link.hreflang);
      } catch {
        // Storage unavailable: navigation still works, the choice just isn't remembered.
      }
    });
  });
</script>
