---
import { SITE } from '../config/site';
import {
  LOCALE_INFO,
  getAlternates,
  getLocale,
  getSortedVisibleCategories,
  localizePath,
  splitLocalePath,
  useTranslations,
} from '../i18n';

interface Props {
  /**
   * Forces every link here to do a real navigation instead of an Astro view-transition swap.
   * Admin passes this: it mounts several viewers that each attach their own window/document
   * listeners with no way to tear them down (see admin.astro's script), and a fetch-based swap
   * away from it while those are still doing async work can be aborted mid-flight — Astro's own
   * fallback for that has been observed leaving a blank page rather than completing the real
   * navigation it's meant to fall back to. A full reload sidesteps the race entirely.
   */
  forceReload?: boolean;
}

const { forceReload = false } = Astro.props;
const locale = getLocale(Astro);
const t = useTranslations(locale);

// Compare against the locale-less path so "active" works the same in every language.
const currentPath = splitLocalePath(Astro.url.pathname).path.replace(/\/+$/, '') || '/';
const sortedCategories = getSortedVisibleCategories(locale);
const alternates = getAlternates(Astro.url.pathname);
// Where the "Portfolio" menu itself goes (desktop click; see the script below) — the home page's own
// "Explore by Category" section, not a work page: hovering already offers every category directly.
const exploreByCategoryHref = `${localizePath('/', locale)}#explore-by-category`;
---

<header class="site-header">
  <div class="wrap bar">
    {/* Its own top-left corner, outside <nav>: always visible, even with the mobile menu collapsed. */}
    <div class="lang-switcher" role="group" aria-label={t('nav.language')}>
      {alternates.map((alt) =>
        alt.current ? (
          <span class="lang-current" lang={alt.locale} aria-current="true" title={LOCALE_INFO[alt.locale].name}>
            {LOCALE_INFO[alt.locale].short}
          </span>
        ) : (
          <a
            href={alt.path}
            lang={alt.locale}
            hreflang={alt.locale}
            title={LOCALE_INFO[alt.locale].name}
            aria-label={LOCALE_INFO[alt.locale].name}
            data-astro-reload={forceReload}
          >
            {LOCALE_INFO[alt.locale].short}
          </a>
        )
      )}
    </div>

    <a href={localizePath('/', locale)} class="brand" data-astro-reload={forceReload}>
      {/* The gold signature logo (original: docs/brand/logo-gold-original-4k.png, cropped and sized to 720 px wide). */}
      <img src="/logo.png" width="720" height="316" alt={SITE.author} class="brand-logo" fetchpriority="high" decoding="async" />
    </a>

    <button type="button" class="nav-toggle" aria-expanded="false" aria-controls="primary-nav" id="nav-toggle">
      <span class="visually-hidden">{t('nav.toggleNavigation')}</span>
      <span class="nav-toggle-icon"></span>
    </button>

    <nav id="primary-nav" class="primary-nav">
      <div class="nav-group">
        {/* A real <button>, not a link: aria-expanded/aria-controls need it to announce right as a
            disclosure control (see accessibility-and-compatibility.feature). Hovering or tabbing to
            it already reveals the dropdown below (CSS :hover/:focus-within) — its own click goes
            straight to the home page's category section instead, on a screen wide enough to hover in
            the first place; on a narrow one, with no hover, clicking it opens the dropdown instead
            (see initHeader below). */}
        <button
          type="button"
          class="nav-label"
          id="nav-work-toggle"
          aria-expanded="false"
          aria-controls="nav-work-dropdown"
          data-explore-href={exploreByCategoryHref}
        >
          {t('nav.work')}
        </button>
        <div class="nav-dropdown" id="nav-work-dropdown">
          <div class="nav-dropdown-panel">
            {/* Every photo, no filter — the same pseudo-category work/[category].astro's own filter
                bar prepends, first, ahead of the real ones below (a border sets it apart from them). */}
            <a
              href={localizePath('/work/all/', locale)}
              class:list={{ 'nav-dropdown-all': true, active: currentPath === '/work/all' }}
              data-astro-reload={forceReload}
            >
              {t('work.allLabel')}
            </a>
            {sortedCategories.map((c) => (
              <a
                href={localizePath(`/work/${c.slug}/`, locale)}
                class:list={{ active: currentPath === `/work/${c.slug}` }}
                data-astro-reload={forceReload}
              >
                {c.label}
              </a>
            ))}
          </div>
        </div>
      </div>
      <a href={localizePath('/about/', locale)} class:list={{ active: currentPath === '/about' }} data-astro-reload={forceReload}>
        {t('nav.about')}
      </a>
      <a href={localizePath('/contact/', locale)} class:list={{ active: currentPath === '/contact' }} data-astro-reload={forceReload}>
        {t('nav.contact')}
      </a>
      {/* The Admin page is deliberately not linked here: it stays reachable directly at /admin/, just not advertised. */}
      {/* A page's own menu items after Contact (the Admin page's Refresh and Sign out). */}
      <slot name="nav-actions" />
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 40;
    background: rgba(11, 12, 14, 0.85);
    -webkit-backdrop-filter: blur(8px);
    backdrop-filter: blur(8px);
    border-bottom: 1px solid var(--border);
  }

  .bar {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    /* A real floor, not just each side's own 1fr: the two outer tracks aren't actually equal width
       in practice (this side's nav links need far more min-content room than the other side's
       language switcher), so as the viewport narrows toward the mobile nav-toggle breakpoint below,
       the wider one claims more of the grid — pushing the centered brand column toward the narrower
       side and closing the gap between it (the logo) and whatever sits right next to it. column-gap guarantees they never actually touch. */
    column-gap: var(--space-4);
    align-items: center;
    padding-block: var(--space-2);
  }

  .brand {
    grid-column: 2;
    justify-self: center;
    display: flex;
    align-items: center;
    gap: 0.75rem;
    text-decoration: none;
  }

  .brand-logo {
    height: 6rem;
    width: auto;
    display: block;
    /* Never squeezed out of shape by a crowded menu. */
    flex-shrink: 0;
  }

  .primary-nav {
    grid-column: 3;
    justify-self: end;
    display: flex;
    align-items: center;
    gap: var(--space-3);
    /* Every item on one line, however many words ("Sobre mí", "Cerrar sesión"). */
    white-space: nowrap;
  }

  .primary-nav > a {
    text-decoration: none;
    font-size: 1.0rem;
    color: var(--fg-muted);
    transition: color 0.2s ease;
  }

  .primary-nav > a:hover,
  .primary-nav > a.active {
    color: var(--fg);
  }

  /* The shared hover highlight (global.css): a tinted face and a gold bar under the word. It only ever changes colours:
     in the folded (☰) menu, a hover that resized its row moved the next row under the pointer, and the two traded the
     hover back and forth endlessly (the menu flickered). Only the wide header pads the face out around the word, with
     margins that cancel it so nothing moves. */
  @media (hover: hover) {
    .primary-nav > a:hover,
    .nav-label:hover,
    .lang-switcher a:hover {
      background: var(--hover-face);
      box-shadow: var(--hover-bar);
    }
  }
  @media (hover: hover) and (min-width: 901px) {
    .primary-nav > a:hover,
    .nav-label:hover {
      padding: 0.2rem 0.4rem;
      margin: -0.2rem -0.4rem;
      border-radius: var(--radius);
    }
  }
  @media (hover: hover) {
    .lang-switcher a:hover {
      padding: 0.2rem 0.4rem;
      margin: -0.2rem -0.4rem;
      border-radius: var(--radius);
    }
    .nav-dropdown a:hover,
    .nav-dropdown a.active:hover {
      background: var(--hover-face);
      box-shadow: var(--hover-bar);
    }
    .nav-toggle:hover {
      background: var(--hover-face);
      border-color: var(--accent);
    }
  }

  .lang-switcher {
    --lang-switch: #ffe600;
    --lang-switch-hover: #fff27a;
    grid-column: 1;
    justify-self: start;
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-size: 0.85rem;
    letter-spacing: 0.05em;
  }

  .lang-switcher a {
    text-decoration: none;
    color: var(--lang-switch);
    transition: color 0.2s ease;
  }

  .lang-switcher a:hover {
    color: var(--lang-switch-hover);
  }

  /* Same yellow as the link; bold + underline marks the active language. */
  .lang-current {
    color: var(--lang-switch);
    font-weight: 700;
    text-decoration: underline;
    text-underline-offset: 0.25em;
  }

  .nav-group {
    position: relative;
  }

  .nav-label {
    background: none;
    border: none;
    font: inherit;
    padding: 0;
    cursor: pointer;
    font-size: 1.0rem;
    color: var(--fg-muted);
    transition: color 0.2s ease;
  }

  .nav-label:hover {
    color: var(--fg);
  }

  .nav-dropdown {
    position: absolute;
    top: 100%;
    /* Flush with "Portfolio": each item's text starts where its label does, so the panel sits out to the left by its
       border, its padding and an item's own padding (the frame and the hover face reach just past the words). */
    left: 0;
    margin-left: calc(-1 * (1px + var(--space-1) + 0.75rem));
    /* The gap before the visible panel (below) is padding, not margin, and stays part of this
       element's own box: margin would leave a dead zone with nothing to hover in between, and since
       the whole thing switches to pointer-events: none while closed, the pointer sliding through that
       gap would hit-test straight past it to the page behind — dropping .nav-group's :hover (and with
       it, this dropdown's own pointer-events) before the pointer ever reaches a category, closing the
       menu on the way down to it instead of letting it be clicked. */
    padding-top: var(--space-2);
    opacity: 0;
    /* Kept focusable (not visibility:hidden) so keyboard users tabbing
       to these links triggers :focus-within below and reveals them —
       matching what mouse users get on :hover. */
    pointer-events: none;
    transform-origin: top center;
    transition: opacity 0.15s ease;
  }

  .nav-group:hover .nav-dropdown,
  .nav-group:focus-within .nav-dropdown {
    opacity: 1;
    pointer-events: auto;
  }

  .nav-dropdown-panel {
    display: flex;
    flex-direction: column;
    min-width: 180px;
    padding: var(--space-1);
    background: var(--bg-elevated);
    border: 1px solid var(--border);
    border-radius: var(--radius);
  }

  .nav-dropdown a {
    padding: 0.7rem 0.75rem;
    text-decoration: none;
    font-size: 0.85rem;
    color: var(--fg-muted);
    border-radius: var(--radius);
    white-space: nowrap;
  }

  .nav-dropdown a:hover {
    color: var(--fg);
  }

  /* The page you're on (hover takes the shared highlight, above). */
  .nav-dropdown a.active {
    color: var(--fg);
    background: rgba(255, 255, 255, 0.04);
  }

  /* Sets "All" apart from the specific categories under it, since it isn't one of them. */
  .nav-dropdown-all {
    margin-bottom: 0.25rem;
    padding-bottom: calc(0.7rem + 0.25rem);
    border-bottom: 1px solid var(--border);
  }

  .nav-toggle {
    grid-column: 3;
    justify-self: end;
    display: none;
    align-items: center;
    justify-content: center;
    min-width: 44px;
    min-height: 44px;
    background: none;
    border: none;
    color: var(--fg);
    padding: 0.5rem;
    cursor: pointer;
  }

  .nav-toggle-icon,
  .nav-toggle-icon::before,
  .nav-toggle-icon::after {
    display: block;
    width: 22px;
    height: 2px;
    background: currentColor;
    position: relative;
    transition: transform 0.2s ease;
  }

  .nav-toggle-icon::before,
  .nav-toggle-icon::after {
    content: '';
    position: absolute;
  }

  .nav-toggle-icon::before {
    top: -7px;
  }

  .nav-toggle-icon::after {
    top: 7px;
  }

  @media (max-width: 720px) {
    .brand-logo {
      height: 3.75rem;
    }
  }

  /* The menu folds behind the ☰ button below 900px: wide enough for the Admin page's five items in Spanish
     ("Portafolio … Cerrar sesión") on one line beside the full-size logo. */
  @media (max-width: 900px) {
    .nav-toggle {
      display: flex;
    }

    .primary-nav {
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      /* Full width, not shrunk to its words at the right (the wide header's justify-self: end, which also applies to
         an absolutely placed grid child). */
      justify-self: stretch;
      margin-left: 0;
      flex-direction: column;
      align-items: stretch;
      gap: 0;
      background: var(--bg-elevated);
      border-bottom: 1px solid var(--border);
      max-height: 0;
      overflow: hidden;
      transition: max-height 0.25s ease;
    }

    .primary-nav.open {
      max-height: 560px;
    }

    .primary-nav > a {
      padding: var(--space-2) var(--space-3);
      border-top: 1px solid var(--border);
    }

    .nav-group {
      padding: var(--space-2) var(--space-3);
      border-top: 1px solid var(--border);
    }

    .nav-dropdown {
      position: static;
      transform: none;
      margin-left: 0;
      opacity: 1;
      /* Mobile shows/hides via the .open class (JS), not hover/focus,
         so it must stay clickable regardless of focus state. */
      pointer-events: auto;
      display: none;
      padding: 0;
    }

    .nav-dropdown-panel {
      border: none;
      background: none;
      min-width: 0;
      padding: 0;
      margin-top: var(--space-1);
    }

    .nav-group.open .nav-dropdown {
      display: flex;
    }
  }
</style>

<script>
  import { storeLocale } from '../i18n/geo.ts';

  // Astro bundles this script to one stable URL shared by every page, so the browser's module
  // cache only ever evaluates it once per tab — a direct top-level call here would only ever wire
  // up the very first page's header. `astro:page-load` fires again on every later view-transition
  // navigation (and once for the very first load too, via the native `load` event), each time
  // against that page's own fresh #nav-toggle/#primary-nav elements, so re-querying and
  // re-attaching on every firing is what makes the mobile menu and language switcher keep working
  // after a client-routed navigation.
  let removeKeydown: (() => void) | null = null;

  function initHeader() {
    // `document` persists across transitions; without removing the previous page's handler first,
    // each navigation would stack another Escape listener that still (harmlessly, but wastefully)
    // matches against whichever header is currently live.
    removeKeydown?.();
    removeKeydown = null;

    const toggle = document.getElementById('nav-toggle');
    const nav = document.getElementById('primary-nav');
    const navGroup = nav?.querySelector('.nav-group');
    const navLabel = navGroup?.querySelector('.nav-label');

    toggle?.addEventListener('click', () => {
      const isOpen = nav?.classList.toggle('open');
      toggle.setAttribute('aria-expanded', String(Boolean(isOpen)));
    });

    // Escape closes the open mobile menu and hands focus back to its button.
    const onKeydown = (event: KeyboardEvent) => {
      if (event.key === 'Escape' && nav?.classList.contains('open')) {
        nav.classList.remove('open');
        toggle?.setAttribute('aria-expanded', 'false');
        (toggle as HTMLElement | null)?.focus();
      }
    };
    document.addEventListener('keydown', onKeydown);
    removeKeydown = () => document.removeEventListener('keydown', onKeydown);

    navLabel?.addEventListener('click', () => {
      // Narrow enough that hovering was never an option (matches the CSS breakpoint above): clicking
      // is the only way to reach the dropdown at all, so it opens it, the same as it always has.
      if (window.innerWidth <= 900) {
        const isOpen = navGroup?.classList.toggle('open');
        navLabel.setAttribute('aria-expanded', String(Boolean(isOpen)));
        return;
      }
      // Wide enough to have already hovered (or tabbed) the dropdown open: the button's own click
      // goes to the home page's category section instead of doing nothing.
      const href = navLabel.getAttribute('data-explore-href');
      if (href) window.location.href = href;
    });

    // Clicking the language switcher is an explicit choice: remember it so the
    // location-based default on the home page never overrides it.
    document.querySelectorAll<HTMLAnchorElement>('.lang-switcher a[hreflang]').forEach((link) => {
      link.addEventListener('click', () => {
        try {
          storeLocale(window.localStorage, link.hreflang);
        } catch {
          // Storage unavailable: navigation still works, the choice just isn't remembered.
        }
      });
    });
  }

  document.addEventListener('astro:page-load', initHeader);
</script>
