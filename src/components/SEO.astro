---
import { SITE } from '../config/site';
import { DEFAULT_LOCALE, LOCALE_INFO, getAlternates, getLocale, useTranslations } from '../i18n';

interface Props {
  title: string;
  description?: string;
  /** Share image (absolute URL or site path); defaults to the branded /og-image.png. */
  image?: string;
  imageAlt?: string;
  imageWidth?: number;
  imageHeight?: number;
  noindex?: boolean;
  /** schema.org objects to publish as JSON-LD. */
  jsonLd?: object[];
}

const locale = getLocale(Astro);
const t = useTranslations(locale);
const siteTitle = t('site.title');

const {
  title,
  description = t('site.description'),
  image = '/og-image.png',
  imageAlt = siteTitle,
  imageWidth = image === '/og-image.png' ? 1200 : undefined,
  imageHeight = image === '/og-image.png' ? 630 : undefined,
  noindex = false,
  jsonLd = [],
} = Astro.props;
const pageTitle = title === siteTitle ? title : `${title} · ${siteTitle}`;
const canonicalURL = new URL(Astro.url.pathname, SITE.url);

// Every translation of this page, for hreflang. The default locale doubles as x-default.
const alternates = getAlternates(Astro.url.pathname).map((alt) => ({
  ...alt,
  url: new URL(alt.path, SITE.url),
}));
const xDefault = alternates.find((alt) => alt.locale === DEFAULT_LOCALE)!;
---

<title>{pageTitle}</title>
<meta name="description" content={description} />
{noindex && <meta name="robots" content="noindex" />}
{!noindex && <link rel="canonical" href={canonicalURL} />}
{!noindex && alternates.map((alt) => <link rel="alternate" hreflang={alt.locale} href={alt.url} />)}
{!noindex && <link rel="alternate" hreflang="x-default" href={xDefault.url} />}

<meta property="og:type" content="website" />
<meta property="og:title" content={pageTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonicalURL} />
<meta property="og:locale" content={LOCALE_INFO[locale].ogLocale} />
{alternates
  .filter((alt) => alt.locale !== locale)
  .map((alt) => <meta property="og:locale:alternate" content={LOCALE_INFO[alt.locale].ogLocale} />)}
{!noindex && <meta property="og:image" content={new URL(image, SITE.url)} />}
{!noindex && imageWidth && <meta property="og:image:width" content={String(imageWidth)} />}
{!noindex && imageHeight && <meta property="og:image:height" content={String(imageHeight)} />}
{!noindex && <meta property="og:image:alt" content={imageAlt} />}

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={pageTitle} />
<meta name="twitter:description" content={description} />
{!noindex && <meta name="twitter:image" content={new URL(image, SITE.url)} />}
{!noindex && <meta name="twitter:image:alt" content={imageAlt} />}
{jsonLd.map((item) => <script type="application/ld+json" set:html={JSON.stringify(item)} />)}
