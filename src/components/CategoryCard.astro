---
import type { PhotoEntry } from '../config/photo-manifest';
import { COVER_SRCSET, photoSrcSet, photoVariant } from '../config/photos';
import { getLocale, getPhotoTitle, localizePath, type LocalizedCategory } from '../i18n';

interface Props {
  category: LocalizedCategory;
  cover?: PhotoEntry;
}

const { category, cover } = Astro.props;
const locale = getLocale(Astro);
const image = cover ? photoVariant(cover.data.photo, 'cover') : null;
const srcset = cover ? photoSrcSet(cover.data.photo, COVER_SRCSET) : undefined;
---

<a class="category-card" href={localizePath(`/work/${category.slug}/`, locale)}>
  <div class="cover">
    {image && <img src={image.src} width={image.width} height={image.height} srcset={srcset} sizes="(max-width: 600px) 100vw, 320px" alt={cover ? getPhotoTitle(cover.data, locale) : category.label} loading="lazy" decoding="async" />}
  </div>
  <div class="label">
    <h3>{category.label}</h3>
    <p>{category.description}</p>
  </div>
</a>

<style>
  .category-card {
    display: block;
    text-decoration: none;
    color: var(--fg);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    overflow: hidden;
    background: var(--bg-elevated);
    transition: border-color 0.2s ease, transform 0.2s ease;
  }

  .category-card:hover {
    border-color: var(--accent);
    transform: translateY(-2px);
  }

  .cover {
    aspect-ratio: 4 / 3;
    background: #1a1b1e;
    overflow: hidden;
  }

  .cover img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .label {
    padding: var(--space-2) var(--space-3);
  }

  .label h3 {
    margin-bottom: 0.35rem;
    font-size: 1.15rem;
  }

  .label p {
    margin: 0;
    font-size: 0.85rem;
  }
</style>
