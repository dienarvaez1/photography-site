---
import { SITE } from '../config/site';
import { getLocale, useTranslations } from '../i18n';

const t = useTranslations(getLocale(Astro));

const year = new Date().getFullYear();
// Which build this is (scripts/lib/build-info.mjs): the release tag, or the short commit hash. The full hash is in the
// hover text and, with when it was built, in data attributes for anyone checking which code is live.
// Each spelled out in full: the build replaces the literal `import.meta.env.NAME` (astro.config.mjs's `define`), so a
// destructured `import.meta.env` would not see them.
const BUILD_LABEL = import.meta.env.BUILD_LABEL;
const BUILD_COMMIT = import.meta.env.BUILD_COMMIT;
const BUILD_TIME = import.meta.env.BUILD_TIME;
---

<footer class="site-footer">
  <div class="wrap footer-bar">
    <p>{t('footer.copyright', { year, author: SITE.author })}</p>
    <div class="footer-end">
      <div class="footer-links">
        {SITE.social.instagram && (
          <a href={SITE.social.instagram} target="_blank" rel="noopener noreferrer">
            {t('footer.instagram')}<span class="visually-hidden"> {t('footer.opensInNewTab')}</span>
          </a>
        )}
        {SITE.social.facebook && (
          <a href={SITE.social.facebook} target="_blank" rel="noopener noreferrer">
            {t('footer.facebook')}<span class="visually-hidden"> {t('footer.opensInNewTab')}</span>
          </a>
        )}
      </div>
      <p class="build-info" data-build={BUILD_LABEL} data-commit={BUILD_COMMIT ?? ''} data-built-at={BUILD_TIME} title={BUILD_COMMIT ?? undefined}>
        {t('footer.build', { version: BUILD_LABEL })}
      </p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--border);
    margin-top: var(--space-5);
  }

  .footer-bar {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    justify-content: space-between;
    align-items: center;
    padding-block: var(--space-3);
    font-size: 0.75rem;
    color: var(--fg-muted);
  }

  .footer-bar p {
    margin: 0;
  }

  /* The right-hand group: the social links, then the build in the footer's right corner. */
  .footer-end {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3);
    margin-left: auto;
  }

  .footer-links {
    display: flex;
    gap: var(--space-3);
  }

  .footer-links a {
    text-decoration: none;
    color: var(--fg-muted);
  }

  .footer-links a:hover {
    color: var(--fg);
  }
</style>
