---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE } from '../config/site';
import { CATEGORIES } from '../config/categories';

// Free contact form via Web3Forms (no backend, no cost). See README for setup.
const accessKey = import.meta.env.PUBLIC_WEB3FORMS_KEY as string | undefined;
---

<BaseLayout title="Contact" description={`Get in touch with ${SITE.author}`}>
  <section class="wrap contact">
    <p class="eyebrow">Contact</p>
    <h1>Let's work together.</h1>
    <p>
      Tell me a bit about your project and I'll get back to you shortly. You can also email me
      directly at <a href={`mailto:${SITE.email}`}>{SITE.email}</a>.
    </p>

    {accessKey ? (
      <form id="contact-form" class="contact-form">
        <input type="hidden" name="access_key" value={accessKey} />
        <input type="checkbox" name="botcheck" class="visually-hidden" tabindex="-1" autocomplete="off" />

        <label>
          Name
          <input type="text" name="name" required />
        </label>

        <label>
          Email
          <input type="email" name="email" required />
        </label>

        <label>
          What are you interested in?
          <select name="category">
            {CATEGORIES.map((c) => (
              <option value={c.label}>{c.label}</option>
            ))}
            <option value="Other">Other</option>
          </select>
        </label>

        <label>
          Message
          <textarea name="message" rows="5" required></textarea>
        </label>

        <button type="submit" class="btn btn-primary">Send Message</button>
        <p id="form-status" class="form-status" role="status"></p>
      </form>
    ) : (
      <p class="notice">
        The contact form isn't configured yet. Add a free
        <a href="https://web3forms.com/" target="_blank" rel="noopener noreferrer">Web3Forms</a>
        access key as <code>PUBLIC_WEB3FORMS_KEY</code> to enable it — see the README. Until then,
        please reach out via email above.
      </p>
    )}
  </section>
</BaseLayout>

<style>
  .contact {
    padding-block: var(--space-5);
    max-width: 560px;
  }

  .contact h1 {
    font-size: clamp(1.8rem, 4vw, 2.6rem);
  }

  .contact-form {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    margin-top: var(--space-3);
  }

  .contact-form label {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    font-size: 0.85rem;
    color: var(--fg-muted);
  }

  .contact-form input[type='text'],
  .contact-form input[type='email'],
  .contact-form select,
  .contact-form textarea {
    background: var(--bg-elevated);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 0.65rem 0.75rem;
    color: var(--fg);
    font: inherit;
  }

  .contact-form button {
    align-self: flex-start;
    margin-top: var(--space-1);
    cursor: pointer;
  }

  .form-status {
    min-height: 1.2em;
    font-size: 0.85rem;
  }

  .notice {
    background: var(--bg-elevated);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: var(--space-2) var(--space-3);
    font-size: 0.9rem;
  }

  .notice code {
    background: rgba(255, 255, 255, 0.08);
    padding: 0.1rem 0.35rem;
    border-radius: 3px;
  }
</style>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement | null;
  const status = document.getElementById('form-status');

  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    if (!status) return;

    const submitBtn = form.querySelector('button[type="submit"]') as HTMLButtonElement | null;
    submitBtn && (submitBtn.disabled = true);
    status.textContent = 'Sending...';

    try {
      const formData = new FormData(form);
      const response = await fetch('https://api.web3forms.com/submit', {
        method: 'POST',
        headers: { Accept: 'application/json' },
        body: formData,
      });
      const result = await response.json();

      if (result.success) {
        status.textContent = "Thanks! Your message has been sent — I'll be in touch soon.";
        form.reset();
      } else {
        status.textContent = 'Something went wrong. Please try emailing me directly instead.';
      }
    } catch {
      status.textContent = 'Something went wrong. Please try emailing me directly instead.';
    } finally {
      submitBtn && (submitBtn.disabled = false);
    }
  });
</script>
