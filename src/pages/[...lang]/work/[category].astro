---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Gallery from '../../../components/Gallery.astro';
import { CATEGORIES } from '../../../config/categories';
import { photoVariant } from '../../../config/photos';
import { notFound } from '../../../lib/not-found';
import { getPhotos } from '../../../lib/photo-entries';
import { DEFAULT_SORT, sortPhotos } from '../../../lib/photo-sort';
import en from '../../../i18n/en.json';
import es from '../../../i18n/es.json';
import {
  getLocale,
  getLocalizedCategory,
  getPhotoTitle,
  getSortedVisibleCategories,
  isLangParam,
  localeStaticParams,
  localizePath,
  useTranslations,
} from '../../../i18n';

// "All" is a pseudo-category, not a real configured one: every visible category's photos with no
// filter, not a category of its own to edit in Category Maintenance or offer on the contact form.
// The header's Portfolio dropdown prepends the exact same pseudo-category (see Header.astro).
// Repeated as a literal in getStaticPaths just below, not shared as one constant: Astro extracts and
// runs that function in isolation (to build every route's params before rendering any of them), a
// scope that doesn't see this module's other top-level code — a plain `ALL_SLUG` reference there
// fails at build time with "ALL_SLUG is not defined", imports (CATEGORIES, localeStaticParams) below
// excepted.
const ALL_SLUG = 'all';

// Rendered when requested, from the entries in R2 (`output: 'server'`, see astro.config.mjs); the tests' snapshot build makes it static.
export function getStaticPaths() {
  return localeStaticParams().flatMap(({ params }) => [
    { params: { ...params, category: 'all' } }, // ALL_SLUG, see its own comment above
    ...CATEGORIES.map((category) => ({ params: { ...params, category: category.slug } })),
  ]);
}

const locale = getLocale(Astro);
const t = useTranslations(locale);
const { category: slug, lang } = Astro.params;
const isAll = slug === ALL_SLUG;
if (!isLangParam(lang) || (!isAll && !CATEGORIES.some((c) => c.slug === slug))) return notFound();

// Every other visible category, for the on-page filter bar and (via categoriesData below) the script
// that progressively enhances it: clicking one is a real link (works with no JS, exactly like the
// header's Work dropdown), swapped in place instead of navigating once the script has loaded.
// `data-categories` carries what the script needs to relabel the page for a category it wasn't
// server-rendered for — just the small amount of per-category text (label, description), not the
// photos themselves (those come from the manifest, fetched separately — see the script). "All" is
// prepended here, first, the same pseudo-category the header's dropdown prepends too.
const allCategory = { slug: ALL_SLUG, label: t('work.allLabel'), description: t('work.allDescription') };
const sortedCategories = [allCategory, ...getSortedVisibleCategories(locale)];
const visibleSlugs = new Set(sortedCategories.map((c) => c.slug));
const categoriesData = JSON.stringify(sortedCategories.map((c) => ({ slug: c.slug, label: c.label, description: c.description })));

const category = isAll ? allCategory : getLocalizedCategory(slug!, locale)!;
// Already in the Sort by control's default order (newest first), so the first paint — and a visitor with no JS, who
// never gets the control at all — sees the same order the control shows as selected.
const photos = sortPhotos(
  (await getPhotos()).filter((p) => (isAll ? visibleSlugs.has(p.data.category) : p.data.category === slug)),
  DEFAULT_SORT
);

// Share this category's first photo when the page is linked on social media / messaging apps.
const first = photos[0];
const share = first ? photoVariant(first.data.photo, 'full') : undefined;
// The one string the script needs to build a tile's aria-label for a photo it fetched itself,
// rather than pulling in the whole i18n module (with both locales' full message trees) into the
// client bundle just for this.
const openPhotoTemplate = (locale === 'es' ? es : en).gallery.openPhoto;
---

<BaseLayout
  title={category.label}
  description={category.description}
  image={share?.src}
  imageWidth={share?.width}
  imageHeight={share?.height}
  imageAlt={first ? getPhotoTitle(first.data, locale) : undefined}
>
  <section class="wrap header">
    <p class="eyebrow">{t('work.eyebrow')}</p>

    {/* A group of links, not a `<nav>`: the header already has the site's one navigation landmark,
        and axe-core's unique-landmark rule wants every `<nav>` on a page distinctly named — these
        pills are a content-level filter for the gallery below, not a second section of the site to
        navigate, so `role="group"` names them without adding a second landmark. */}
    <div
      class="category-filter"
      id="category-filter"
      role="group"
      aria-label={t('work.filterLabel')}
      data-categories={categoriesData}
      data-open-photo-template={openPhotoTemplate}
    >
      {sortedCategories.map((c) =>
        c.slug === slug ? (
          <span class="filter-pill is-current" data-slug={c.slug} aria-current="page">{c.label}</span>
        ) : (
          <a class="filter-pill" data-slug={c.slug} href={localizePath(`/work/${c.slug}/`, locale)}>{c.label}</a>
        )
      )}
    </div>

    <h1 id="work-heading">{category.label}</h1>

    <div class="description-row">
      <p id="work-description">{category.description}</p>

      {/* Invisible (not `hidden`) until the script reveals it: a sort control that does nothing
          without JS is worse than no control at all — but its box stays in flow from the very first
          paint, at its final size, so revealing it only flips a paint property, never adds or removes
          space. It used to be `hidden` (display: none, no box at all), which was a measured
          Cumulative Layout Shift (features/browser/security-and-performance.feature) once JS revealed
          it, not a flake. */}
      <div class="sort-control" id="gallery-controls">
        <label for="gallery-sort">{t('work.sortLabel')}</label>
        {/* A native tooltip, not a custom one: this is exactly what `title` is for, needs no JS or
            markup of its own, and matters most in the mobile breakpoint's compact/icon-only mode
            (below), where the visible "Sort by" text is gone and only the label — already there for
            screen readers — no longer shows sighted mouse users what the control does at a glance. */}
        <select id="gallery-sort" title={t('work.sortLabel')}>
          <option value="order" selected={DEFAULT_SORT === 'order'}>{t('work.sortCurated')}</option>
          <option value="newest" selected={DEFAULT_SORT === 'newest'}>{t('work.sortNewest')}</option>
          <option value="oldest" selected={DEFAULT_SORT === 'oldest'}>{t('work.sortOldest')}</option>
        </select>
      </div>
    </div>
  </section>

  <section class="wrap section work-photos">
    <p id="empty-message" class="empty-message" hidden={photos.length > 0}>{t('work.empty')}</p>
    {/* Not `slug` on "All": a page mixing every category has no one category of its own for the
        lightbox's "View <category> gallery" link to default to before any photo is opened — same
        reasoning as the home page's Featured strip, which passes no category prop for the same
        reason. Gallery falls back to the first tile's own real category instead. */}
    {/* showDetails off: the Portfolio shows the photos alone — no title/camera caption over a tile, no camera line
        in the lightbox. buildTile() in the script below builds its tiles the same way. */}
    <Gallery photos={photos} category={isAll ? undefined : slug} showDetails={false} />
  </section>
</BaseLayout>

<style is:global>
  /* Global, not Astro's default scoped CSS: the category switcher script below rebuilds the pills
     (and reveals the sort control) with document.createElement(), and elements built that way never
     get the data-astro-cid attribute scoped CSS selectors require — see the longer explanation in
     Gallery.astro's own <style> block, which has the identical reason. Every class/id here
     (.category-filter, .filter-pill, .sort-control, #gallery-controls, #gallery-sort, …) is specific
     to this page, so nothing else on the site can collide with it.
  */
  .header {
    padding-block: var(--space-4) var(--space-2);
    max-width: 700px;
  }

  /* The category summary and the sort control share this line — space-between puts the summary at
     the start and the control at the end, same as the control's own old, separate right-aligned row
     used to. wrap: a long (especially Spanish) description at a narrow width drops the control to
     its own line underneath rather than overlapping it. */
  .description-row {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    margin-bottom: var(--space-2);
  }

  /* The row above owns the bottom spacing (its own margin-bottom) that this paragraph's default
     (global.css) margin would otherwise duplicate. flex/min-width let a long description wrap onto
     a second line of its own — rather than the row itself wrapping, which would push the sort
     control below it instead of keeping the two side by side even at phone widths (the compact,
     icon-sized control below exists specifically so there's always room for both). */
  .description-row p {
    margin: 0;
    flex: 1 1 auto;
    min-width: 0;
  }

  /* Stays its own size regardless of how much room the description next to it needs, instead of
     flex dividing the row's width evenly between the two and shrinking this one too. */
  .sort-control {
    flex-shrink: 0;
  }

  /* Sits right under the eyebrow, ahead of the category name and description below it — the `p`
     rule's own bottom margin (global.css) already spaces it from the eyebrow above; this adds the
     matching gap before the `h1` that follows, since h1's own margin is a top-less `margin: 0 0
     var(--space-2)`. */
  .category-filter {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.5rem;
    width: 100%;
    margin-bottom: var(--space-2);
  }

  .filter-pill {
    display: inline-flex;
    align-items: center;
    min-height: 36px;
    padding: 0.4rem 0.9rem;
    border: 1px solid var(--border);
    border-radius: 999px;
    font-size: 0.85rem;
    text-decoration: none;
    color: var(--fg-muted);
    transition: border-color 0.2s ease, color 0.2s ease;
  }

  a.filter-pill:hover {
    border-color: var(--accent);
    color: var(--fg);
  }

  .filter-pill.is-current {
    border-color: var(--accent);
    color: var(--fg);
  }

  /* visibility, not display: none — its box stays in flow (on its own row, reserving that row's
     height) from the very first paint, whether or not the script ever runs; initCategorySwitcher()
     only ever adds .is-ready, once, which flips this to visible without changing its size or
     position. A no-JS visitor sees the same layout as everyone else, just with a quiet gap where a
     working control would be, not a shifted one. */
  .sort-control {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.8rem;
    color: var(--fg-muted);
    visibility: hidden;
  }

  .sort-control.is-ready {
    visibility: visible;
  }

  .sort-control select {
    min-height: 25px;
    padding: 0.1rem 0.5rem;
    background: var(--bg-elevated);
    color: var(--fg);
    border: 1px solid var(--field-border);
    border-radius: var(--radius);
    font: inherit;
  }

  /* A compact, icon-sized control: same "Sort by" <select> (still a real, fully working native
     dropdown, still with its own accessible name — nothing here removes that, only how it looks
     closed), not a second, phone-only control to keep in sync with it. The label collapses to the
     same off-screen-but-still-announced technique as .visually-hidden (global.css) — scoped here,
     not that shared class, since it only applies below this one breakpoint. text-indent shoves the
     select's own text (which would otherwise be squeezed into 25px and truncate unreadably) out of
     its clipped box; appearance: none removes the browser's own native arrow (which it never draws
     centered — only ever trailing, meant for a box with visible text before it) so the two small
     background gradients below can draw one that's actually centered, both ways, in this icon-sized
     box, standing in as the control's icon now that the text itself is hidden. */
  @media (max-width: 640px) {
    .sort-control label {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip: rect(0 0 0 0);
      white-space: nowrap;
    }

    .sort-control select {
      appearance: none;
      width: 25px;
      height: 25px;
      min-width: 25px;
      padding: 0;
      text-indent: -9999px;
      /* Two small diagonal half-squares, placed edge-to-edge (each 5px wide, the second starting
         exactly where the first ends) so together they read as one unbroken "v" rather than two
         separate marks — and in plain px, not %, against this box's own known, fixed 25x25 size
         (border-box, so the border itself counts): percentage-based centering multiplies by
         (container − image) size first, which doesn't actually land two *different* layers side by
         side the way it looks like it should. */
      background-origin: border-box;
      background-image: linear-gradient(45deg, transparent 50%, currentColor 50%), linear-gradient(135deg, currentColor 50%, transparent 50%);
      background-position: 7.5px 10px, 12.5px 10px;
      background-size: 5px 5px, 5px 5px;
      background-repeat: no-repeat;
    }

    /* Chromium (this site's own tested browser) does render <option> font-size in the native popup
       list; a 25px closed control reads oddly paired with a full-size dropdown list, so this shrinks
       that too. Browsers that ignore styled <option>s (e.g. Firefox) just keep their own default
       size — a harmless no-op there, not a broken one. */
    .sort-control option {
      font-size: 0.75rem;
    }
  }

  .section {
    padding-block: var(--space-3) var(--space-5);
  }

  /* Gallery.astro's .gallery is flex-wrap with no justify-content (flex-start, its default, suits
     the home page's Featured strip and Admin's originals list); here specifically, a category with
     few photos — one, or a row the ratio-cap from the crop fix leaves short of full width — reads
     lopsided flush left, so it's centered instead. Scoped to .work-photos, not .gallery itself
     (a global class shared by every page that uses <Gallery>), so this doesn't reach them too. */
  .work-photos .gallery {
    justify-content: center;
  }

  .empty-message[hidden] {
    display: none;
  }
</style>

<script>
  import type { ManifestEntry } from '../../../config/photo-manifest';
  import { THUMB_SRCSET, photoSrcSet, photoVariant, ratioClass } from '../../../config/photos';
  import { DEFAULT_LOCALE } from '../../../i18n/config';
  import { DEFAULT_SORT, SORT_MODES, sortPhotos, type SortMode } from '../../../lib/photo-sort';

  // The site's own origin, not R2 directly: the public web bucket sends no
  // Access-Control-Allow-Origin header, so a cross-origin fetch() to it is blocked by CORS (unlike
  // an <img src>, which isn't subject to that check). This endpoint re-serves getPhotos() same-origin
  // — see src/pages/api/photos.json.ts.
  const PHOTOS_API_URL = '/api/photos.json';
  const EAGER_TILES = 3;
  // Must match this same page's own ALL_SLUG, above — its frontmatter runs only on the server, so
  // this client script (a separate bundle) can't import it and needs its own copy of the constant.
  const ALL_SLUG = 'all';

  const localizePath = (path: string, locale: string) => (locale === DEFAULT_LOCALE ? path : `/${locale}${path}`);
  const photoTitle = (data: { title: string; titles?: Record<string, string> }, locale: string) => data.titles?.[locale] ?? data.title;
  const categorySlugFromPath = (pathname: string) => pathname.match(/\/work\/([a-z0-9-]+)\/?$/)?.[1] ?? null;
  // A lighter check than photo-manifest.ts's own problemWith() — worth its own copy here (not an
  // import) for the bytes: this is the manifest the server itself just wrote and already validated
  // that way when it rendered this very page, not untrusted input, so the client only needs to
  // rule out an entry it would otherwise crash on (a missing size breaks ratioClass()'s division).
  const isUsable = (e: unknown): e is ManifestEntry => {
    const entry = e as { category?: unknown; data?: { photo?: { id?: unknown; width?: unknown; height?: unknown } } };
    return Boolean(entry.category && entry.data?.photo?.id && entry.data.photo.width && entry.data.photo.height);
  };

  // Every category's photos, for this page's filter/sort to switch between — fetched at most once
  // per tab (module-cache reasoning: see Header.astro's script), reused for every switch after that.
  let entriesPromise: Promise<ManifestEntry[]> | null = null;
  function fetchManifestEntries(): Promise<ManifestEntry[]> {
    entriesPromise ??= fetch(PHOTOS_API_URL)
      .then((response) => {
        if (!response.ok) throw new Error(`${PHOTOS_API_URL}: ${response.status}`);
        return response.json();
      })
      .then((entries) => (Array.isArray(entries) ? entries.filter(isUsable) : []))
      .catch((error) => {
        entriesPromise = null; // a network hiccup shouldn't permanently break later switches
        throw error;
      });
    return entriesPromise;
  }

  // A minimal DOM builder, local to this script (not a shared import — the whole point is bytes):
  // a tag name, plain IDL properties (className, textContent, etc.) and children. `dataset` needs
  // its own merge, not a plain assignment — it's a getter-only accessor, so `Object.assign(node,
  // { dataset })` would try to replace it outright and throw.
  function el<K extends keyof HTMLElementTagNameMap>(tag: K, { dataset, ...props }: Record<string, unknown> & { dataset?: Record<string, string> }, ...children: (Node | string)[]): HTMLElementTagNameMap[K] {
    const node = document.createElement(tag);
    Object.assign(node, props);
    if (dataset) Object.assign(node.dataset, dataset);
    node.append(...children);
    return node;
  }

  function buildTile(entry: ManifestEntry, locale: string, openPhotoTemplate: string, index: number): HTMLButtonElement {
    const thumb = photoVariant(entry.data.photo, 'thumb');
    const full = photoVariant(entry.data.photo, 'full');
    const title = photoTitle(entry.data, locale);

    const img = el('img', {
      src: thumb.src, width: thumb.width, height: thumb.height,
      srcset: photoSrcSet(entry.data.photo, THUMB_SRCSET), sizes: '(max-width: 600px) 100vw, 350px',
      alt: title, loading: index < EAGER_TILES ? 'eager' : 'lazy', decoding: 'async',
    });
    const button = el('button', {
      type: 'button',
      className: `tile ${ratioClass(entry.data.photo.width / entry.data.photo.height)}`,
      // No caption and no camera: matches the server-rendered tiles (Gallery's showDetails={false}, above).
      dataset: { id: entry.data.photo.id, full: full.src, caption: title, title, camera: '', placeholder: entry.data.placeholderColor ?? '' },
    }, img);
    button.setAttribute('aria-label', openPhotoTemplate.replace('{title}', title));
    return button;
  }

  let removePopstate: (() => void) | null = null;

  function initCategorySwitcher(root: Document | HTMLElement) {
    removePopstate?.();
    removePopstate = null;

    const filterNav = root.querySelector<HTMLElement>('#category-filter');
    const galleryEl = root.querySelector<HTMLElement>('.gallery');
    const controls = root.querySelector<HTMLElement>('#gallery-controls');
    const sortSelect = root.querySelector<HTMLSelectElement>('#gallery-sort');
    const headingEl = root.querySelector<HTMLElement>('#work-heading');
    const descriptionEl = root.querySelector<HTMLElement>('#work-description');
    const emptyMessageEl = root.querySelector<HTMLElement>('#empty-message');
    if (!filterNav || !galleryEl || !headingEl || !descriptionEl || !emptyMessageEl) return;

    const categories: { slug: string; label: string; description: string }[] = JSON.parse(filterNav.dataset.categories ?? '[]');
    const openPhotoTemplate = filterNav.dataset.openPhotoTemplate ?? '{title}';
    const locale = document.documentElement.lang || DEFAULT_LOCALE;

    let currentSlug = categorySlugFromPath(location.pathname) ?? categories[0]?.slug;
    // What the control shows: the server-rendered default, unless the browser restored another choice (back/forward).
    let currentSort: SortMode = SORT_MODES.find((mode) => mode === sortSelect?.value) ?? DEFAULT_SORT;

    function renderPills(activeSlug: string) {
      filterNav!.innerHTML = '';
      for (const c of categories) {
        if (c.slug === activeSlug) {
          const span = document.createElement('span');
          span.className = 'filter-pill is-current';
          span.dataset.slug = c.slug;
          span.setAttribute('aria-current', 'page');
          span.textContent = c.label;
          filterNav!.append(span);
        } else {
          const a = document.createElement('a');
          a.className = 'filter-pill';
          a.dataset.slug = c.slug;
          a.href = localizePath(`/work/${c.slug}/`, locale);
          a.addEventListener('click', onPillClick);
          a.textContent = c.label;
          filterNav!.append(a);
        }
      }
    }

    // Returns whether it actually updated anything: the pills and the URL (below) must stay exactly
    // as they were, not half-switched to a category whose photos never arrived, when this fails.
    async function renderCategory(slug: string, sort: SortMode): Promise<boolean> {
      const category = categories.find((c) => c.slug === slug);
      if (!category) return false;
      let entries: ManifestEntry[];
      try {
        entries = await fetchManifestEntries();
      } catch {
        return false; // offline or the manifest is unreachable: stay on whatever is already shown
      }
      // "All" shows every entry whose category is one of the ones this page already knows about (the
      // visible ones — `categories` is the exact same list the pills are built from, "All" included,
      // and no real entry's own category is ever literally "all"), not a filter by one category.
      const filtered = sortPhotos(
        slug === ALL_SLUG ? entries.filter((e) => categories.some((c) => c.slug === e.category)) : entries.filter((e) => e.category === slug),
        sort
      );

      headingEl!.textContent = category.label;
      descriptionEl!.textContent = category.description;
      emptyMessageEl!.hidden = filtered.length > 0;
      galleryEl!.innerHTML = '';
      filtered.forEach((entry, index) => galleryEl!.append(buildTile(entry, locale, openPhotoTemplate, index)));
      // Gallery.astro's own script owns the lightbox and blur-up placeholders; this just tells it
      // the tiles it already knows about were replaced (see the fuller explanation in its script).
      document.dispatchEvent(new Event('gallery:refresh'));
      return true;
    }

    function onPillClick(event: MouseEvent) {
      // A modified click (new tab, etc.) should behave like a normal link, not a client-side swap.
      if (event.button !== 0 || event.metaKey || event.ctrlKey || event.altKey || event.shiftKey) return;
      const slug = (event.currentTarget as HTMLElement).dataset.slug;
      if (!slug || slug === currentSlug) return;
      event.preventDefault();
      switchTo(slug, 'push');
    }

    async function switchTo(slug: string, history_: 'push' | 'replace' | 'none') {
      const ok = await renderCategory(slug, currentSort);
      if (!ok) return; // leave the pills, the URL and the page exactly as they were
      currentSlug = slug;
      renderPills(slug);
      const url = localizePath(`/work/${slug}/`, locale);
      if (history_ === 'push') history.pushState(null, '', url);
      else if (history_ === 'replace') history.replaceState(null, '', url);
    }

    // Reacts to the browser's own Back/Forward buttons: the URL has already changed by the time
    // this fires, so this only ever syncs the UI to match it, never touches `history` itself.
    function onPopState() {
      const slug = categorySlugFromPath(location.pathname);
      if (slug && slug !== currentSlug && categories.some((c) => c.slug === slug)) switchTo(slug, 'none');
    }
    window.addEventListener('popstate', onPopState);
    removePopstate = () => window.removeEventListener('popstate', onPopState);

    filterNav.querySelectorAll<HTMLAnchorElement>('a.filter-pill').forEach((a) => a.addEventListener('click', onPillClick));

    if (controls && sortSelect) {
      controls.classList.add('is-ready');
      sortSelect.addEventListener('change', () => {
        currentSort = SORT_MODES.find((mode) => mode === sortSelect.value) ?? 'order';
        renderCategory(currentSlug, currentSort);
      });
      // The server rendered the tiles in DEFAULT_SORT's order; a restored choice needs them re-sorted to match.
      if (currentSort !== DEFAULT_SORT) renderCategory(currentSlug, currentSort);
    }

    // Warms the cache so the first actual switch is instant, without blocking anything above.
    fetchManifestEntries().catch(() => {});
  }

  document.addEventListener('astro:page-load', () => initCategorySwitcher(document));
</script>
