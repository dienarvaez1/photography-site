---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { SITE } from '../../config/site';
import {
  getLocale,
  getMessages,
  localeStaticParams,
  localizePath,
  useTranslations,
} from '../../i18n';

// Built once, as a static file (the site's default is to render on request; see astro.config.mjs).
export const prerender = true;
export const getStaticPaths = localeStaticParams;

const locale = getLocale(Astro);
const t = useTranslations(locale);
const about = getMessages(locale).about;
---

<BaseLayout title={t('about.title')} description={t('about.description', { author: SITE.author })}>
  <section class="wrap about">
    <p class="eyebrow">{t('about.eyebrow')}</p>
    <h1 data-edit-key="about.heading">{t('about.heading')}</h1>

    <div data-edit-key="about.intro" data-edit-kind="paragraphs">{about.intro.map((paragraph) => <p>{paragraph}</p>)}</div>

    <h2 data-edit-key="about.curiosityHeading">{t('about.curiosityHeading')}</h2>
    <div data-edit-key="about.curiosity" data-edit-kind="paragraphs">{about.curiosity.map((paragraph) => <p>{paragraph}</p>)}</div>

    <h2 data-edit-key="about.ctaHeading">{t('about.ctaHeading')}</h2>
    <div data-edit-key="about.cta" data-edit-kind="paragraphs">{about.cta.map((paragraph) => <p>{paragraph}</p>)}</div>

    <a class="btn btn-primary" href={localizePath('/contact/', locale)}>{t('about.button')}</a>
  </section>
</BaseLayout>

<style>
  .about {
    padding-block: var(--space-5);
    max-width: 700px;
  }

  .about h1 {
    font-size: clamp(1.8rem, 4vw, 2.6rem);
  }

  .about h2 {
    margin-top: var(--space-4);
    /* The reference size: every sub-heading site-wide (h2 or h3, never the page's own h1) matches
       this one — the home page's section headings, the Admin tabs and results headings, and the
       category card names. */
    font-size: 1.4rem;
  }

  .about .btn {
    margin-top: var(--space-2);
  }
</style>
