---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { SITE } from '../../config/site';
import { getWeb3FormsKey } from '../../config/web3forms';
import {
  DEFAULT_LOCALE,
  getLocale,
  getLocalizedCategories,
  localeStaticParams,
  useTranslations,
} from '../../i18n';

export const getStaticPaths = localeStaticParams;

const locale = getLocale(Astro);
const t = useTranslations(locale);
// Option values stay English so submissions read the same whatever language the visitor used.
const englishLabels = Object.fromEntries(getLocalizedCategories(DEFAULT_LOCALE).map((c) => [c.slug, c.label]));
const categoryOptions = getLocalizedCategories(locale).map((c) => ({
  value: englishLabels[c.slug],
  label: c.label,
}));

// Free contact form via Web3Forms (no backend, no cost), with a separate form per language.
// See README for setup.
const accessKey = getWeb3FormsKey(locale);

const emailLink = `<a href="mailto:${SITE.email}">${SITE.email}</a>`;
const web3formsLink =
  '<a href="https://web3forms.com/" target="_blank" rel="noopener noreferrer">Web3Forms' +
  `<span class="visually-hidden"> ${t('footer.opensInNewTab')}</span></a>`;
---

<BaseLayout title={t('contact.title')} description={t('contact.description', { author: SITE.author })}>
  <section class="wrap contact">
    <p class="eyebrow">{t('contact.eyebrow')}</p>
    <h1>{t('contact.heading')}</h1>
    <p set:html={t('contact.intro', { email: emailLink })} />

    {accessKey ? (
      <form
        id="contact-form"
        class="contact-form"
        action="https://api.web3forms.com/submit"
        method="POST"
        data-msg-sending={t('contact.sending')}
        data-msg-success={t('contact.success')}
        data-msg-error={t('contact.error')}
      >
        <input type="hidden" name="access_key" value={accessKey} />
        <input
          type="checkbox"
          name="botcheck"
          class="visually-hidden"
          tabindex="-1"
          aria-hidden="true"
        />

        <label>
          {t('contact.name')}
          <input type="text" name="name" required />
        </label>

        <label>
          {t('contact.email')}
          <input type="email" name="email" required />
        </label>

        <label>
          {t('contact.interest')}
          <select name="category">
            {categoryOptions.map((option) => (
              <option value={option.value}>{option.label}</option>
            ))}
            <option value="Other">{t('contact.other')}</option>
          </select>
        </label>

        <label>
          {t('contact.message')}
          <textarea name="message" rows="5" required></textarea>
        </label>

        <button type="submit" class="btn btn-primary">{t('contact.send')}</button>
        <p id="form-status" class="form-status" role="status"></p>
      </form>
    ) : (
      <p class="notice" set:html={t('contact.notConfigured', { link: web3formsLink })} />
    )}
  </section>
</BaseLayout>

<style>
  .contact {
    padding-block: var(--space-5);
    max-width: 560px;
  }

  .contact h1 {
    font-size: clamp(1.8rem, 4vw, 2.6rem);
  }

  .contact-form {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    margin-top: var(--space-3);
  }

  .contact-form label {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    font-size: 0.85rem;
    color: var(--fg-muted);
  }

  .contact-form input[type='text'],
  .contact-form input[type='email'],
  .contact-form select,
  .contact-form textarea {
    background: var(--bg-elevated);
    border: 1px solid var(--field-border);
    border-radius: var(--radius);
    padding: 0.65rem 0.75rem;
    color: var(--fg);
    font: inherit;
  }

  .contact-form button {
    align-self: flex-start;
    margin-top: var(--space-1);
    cursor: pointer;
  }

  .form-status {
    min-height: 1.2em;
    font-size: 0.85rem;
  }

  .notice {
    background: var(--bg-elevated);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: var(--space-2) var(--space-3);
    font-size: 0.9rem;
  }

  .notice code {
    background: rgba(255, 255, 255, 0.08);
    padding: 0.1rem 0.35rem;
    border-radius: 3px;
  }
</style>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement | null;
  const status = document.getElementById('form-status');
  // Localized status messages are rendered into the form's data attributes.
  const msg = form?.dataset ?? {};

  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    if (!status) return;

    const submitBtn = form.querySelector('button[type="submit"]') as HTMLButtonElement | null;
    submitBtn && (submitBtn.disabled = true);
    status.textContent = msg.msgSending ?? '';

    try {
      const formData = new FormData(form);
      const response = await fetch('https://api.web3forms.com/submit', {
        method: 'POST',
        headers: { Accept: 'application/json' },
        body: formData,
      });
      const result = await response.json();

      if (result.success) {
        status.textContent = msg.msgSuccess ?? '';
        form.reset();
      } else {
        status.textContent = msg.msgError ?? '';
      }
    } catch {
      status.textContent = msg.msgError ?? '';
    } finally {
      submitBtn && (submitBtn.disabled = false);
    }
  });
</script>
