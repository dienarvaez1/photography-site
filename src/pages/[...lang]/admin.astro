---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getLocale, getLocalizedCategory, getPhotoTitle, isLangParam, localeStaticParams, useTranslations } from '../../i18n';
import { RESULTS_API_URL } from '../../config/results';
import { CATEGORIES } from '../../config/categories';
import { photoVariant } from '../../config/photos';
import { notFound } from '../../lib/not-found';
import { getPhotos } from '../../lib/photo-entries';
import en from '../../i18n/en.json';
import es from '../../i18n/es.json';

// Rendered when requested (the photos' titles come from R2); the tests' snapshot build makes it static.
export const getStaticPaths = localeStaticParams;

const locale = getLocale(Astro);
if (!isLangParam(Astro.params.lang)) return notFound();
const t = useTranslations(locale);

// The six sections of the page, left to right. Each tab shows its panel; the first one is showing when the page opens.
const tabs = [
  { id: 'access-info', label: t('admin.tabs.accessInfo') },
  { id: 'test-results', label: t('admin.tabs.testResults') },
  { id: 'lighthouse-results', label: t('admin.tabs.lighthouseResults') },
  { id: 'pics-viewer', label: t('admin.tabs.picsViewer') },
  { id: 'category-maintenance', label: t('admin.tabs.categoryMaintenance') },
  { id: 'github-issues', label: t('admin.tabs.githubIssues') },
];

// SITE_ENV decides the Admin buttons (astro.config.mjs; scripts/lib/build-env.mjs siteEnv). On the dev box
// (`development`: under `astro dev`, and any build on the owner's computer, the preview included) every button of the
// Test Results, Lighthouse Test Results, Pics Viewer and Category Maintenance tabs shows: they write to R2 and the site's
// files through the dev server's services, which only allow that on the dev box. In `production` every button inside
// those tabs is hidden. The tests' snapshot build shows them too, to drive them against those services.
const ADMIN_BUTTONS_TABS = new Set(['test-results', 'lighthouse-results', 'pics-viewer', 'category-maintenance']);
const showAdminButtons = __SITE_ENV__ === 'development' || import.meta.env.PHOTOS_SNAPSHOT;

// The viewer's texts travel to the browser as data (an attribute, since the policy allows no inline scripts), in the page's language.
const adminMessages = (locale === 'es' ? es : en).admin;
const resultsMessages = adminMessages.results;
// The Pics Viewer shares the token form, errors and buttons with the Test Results tab.
const { gate, errors, signOut, refresh, loading } = adminMessages.results;
const picsMessages = { pics: adminMessages.pics, gate, errors, signOut, refresh, loading };
// Lighthouse Test Results: the same token form, errors and Remove Results texts, its own texts.
const lighthouseMessages = { lighthouse: adminMessages.lighthouse, removal: adminMessages.results.removal, gate, errors, signOut, refresh, loading };
// Category Maintenance sits behind the same admin token as the other two tabs: its list and its own
// Add/Edit/Remove controls (real content changes, even though the list itself is public once inside)
// only show once signed in.
const categoryMessages = { categories: adminMessages.categories, gate, errors, signOut, refresh, loading };
// GitHub Issues: the same token form and errors, and only the texts its script shows (the intro and the no-JavaScript
// note are already on the page).
const { intro: _issuesIntro, needsJs: _issuesNeedsJs, ...issuesTexts } = adminMessages.issues;
const issuesMessages = { issues: issuesTexts, gate, errors, loading };
// Access Info: the same token form and errors, and only the texts its script shows.
const { intro: _accessIntro, needsJs: _accessNeedsJs, ...accessTexts } = adminMessages.access;
const accessMessages = { access: accessTexts, gate, errors, loading };
// The page's own sign-in: its texts, then the token form's label and states and the errors, shared with the tabs.
const gateMessages = { gate: { ...gate, intro: adminMessages.gate.intro, submit: adminMessages.gate.submit }, errors: { ...errors, notFound: adminMessages.gate.outdated } };

// The categories the New Photo form offers (every configured one, hidden or not), in the page's language.
const formCategories = CATEGORIES.map(({ slug }) => ({ slug, label: getLocalizedCategory(slug, locale)?.label ?? slug }));

// What the site knows about each photo (public information), so the list can say "Orion Nebula" rather than a hash.
const knownPhotos = Object.fromEntries(
  (await getPhotos()).map((entry) => [
    entry.data.photo.id,
    {
      title: getPhotoTitle(entry.data, locale),
      category: getLocalizedCategory(entry.data.category, locale)?.label ?? entry.data.category,
      categorySlug: entry.data.category,
      thumb: photoVariant(entry.data.photo, 'w400'),
      heroBackground: Boolean(entry.data.heroBackground),
      ...(entry.data.takenAt ? { takenAt: entry.data.takenAt } : {}),
    },
  ])
);

// Category Maintenance's own list: just this page's own locale and a photo count (informational only here;
// the local service re-checks it for real before letting a category be removed) — the client's own script
// asks the service for both locales' full text (including descriptions) the moment Edit or Remove is opened,
// so shipping that here too would only bloat this already data-heavy page's HTML for text nothing reads
// before then.
const photoCountsBySlug = Object.values(knownPhotos).reduce<Record<string, number>>((counts, photo) => {
  counts[photo.categorySlug] = (counts[photo.categorySlug] ?? 0) + 1;
  return counts;
}, {});
const categoryRows = CATEGORIES.map(({ slug, hidden }) => ({
  slug,
  hidden: Boolean(hidden),
  label: getLocalizedCategory(slug, locale)?.label ?? slug,
  photoCount: photoCountsBySlug[slug] ?? 0,
}));
---

<!-- Not for search engines, and not in the sitemap. It is public: put Cloudflare Access in front of it before it shows real data. -->
<BaseLayout title={t('admin.title')} description={t('admin.description')} noindex reloadNavLinks noPageEditor>
  <!-- Refresh and Sign out, in the top menu right after Contact and styled like it. Shown by script only while signed in;
       they act on whichever tab is showing. -->
  <div slot="nav-actions" class="nav-actions" role="group" aria-label={t('admin.actionsLabel')} data-admin-actions hidden>
    <button type="button" class="nav-action" data-action="refresh">{t('admin.results.refresh')}</button>
    <button type="button" class="nav-action" data-action="sign-out">{t('admin.results.signOut')}</button>
  </div>
  <section class="wrap admin">
    <div class="admin-head">
      <div>
        <p class="eyebrow">{t('admin.eyebrow')}</p>
        <h1>{t('admin.heading')}</h1>
      </div>
    </div>

    <!-- Only the token box until the token is accepted (src/lib/admin-gate.ts): the tabs below are hidden in the HTML
         itself and revealed by script after the results API has checked the token, never before. -->
    <div class="results admin-gate" data-admin-gate data-api={RESULTS_API_URL} data-messages={JSON.stringify(gateMessages)}>
      <noscript><p>{t('admin.gate.needsJs')}</p></noscript>
    </div>

    <div class="tabs" data-tabs hidden>
      <div class="tablist" role="tablist" aria-label={t('admin.tablistLabel')}>
        {tabs.map((tab, index) => (
          <button
            type="button"
            role="tab"
            class="tab"
            id={`tab-${tab.id}`}
            aria-controls={`panel-${tab.id}`}
            aria-selected={index === 0 ? 'true' : 'false'}
            tabindex={index === 0 ? 0 : -1}
          >
            {tab.label}
          </button>
        ))}
      </div>

      {tabs.map((tab, index) => (
        <div class="tabpanel" role="tabpanel" id={`panel-${tab.id}`} aria-labelledby={`tab-${tab.id}`} tabindex="0" hidden={index !== 0} data-buttons-hidden={!showAdminButtons && ADMIN_BUTTONS_TABS.has(tab.id) ? '' : undefined}>
          <h2>{tab.label}</h2>
          {tab.id === 'test-results' ? (
            <div class="results" data-results data-api={RESULTS_API_URL} data-locale={locale} data-site-env={showAdminButtons ? 'development' : 'production'} data-messages={JSON.stringify(resultsMessages)}>
              <p class="results-intro">{t('admin.results.intro')}</p>
              <div data-results-root aria-live="polite">
                <p>{t('admin.results.loading')}</p>
              </div>
              <noscript><p>{t('admin.results.needsJs')}</p></noscript>
            </div>
          ) : tab.id === 'lighthouse-results' ? (
            <div class="results" data-lighthouse data-api={RESULTS_API_URL} data-locale={locale} data-site-env={showAdminButtons ? 'development' : 'production'} data-messages={JSON.stringify(lighthouseMessages)}>
              <p class="results-intro">{t('admin.lighthouse.intro')}</p>
              <div data-lighthouse-root aria-live="polite">
                <p>{t('admin.results.loading')}</p>
              </div>
              <noscript><p>{t('admin.lighthouse.needsJs')}</p></noscript>
            </div>
          ) : tab.id === 'pics-viewer' ? (
            <div class="results pics" data-pics data-api={RESULTS_API_URL} data-locale={locale} data-messages={JSON.stringify(picsMessages)} data-photos={JSON.stringify(knownPhotos)} data-categories={JSON.stringify(formCategories)}>
              <p class="results-intro">{t('admin.pics.intro')}</p>
              {/* The New Photo form opens here, above the list. */}
              <div data-pics-form></div>
              <div data-pics-root aria-live="polite">
                <p>{t('admin.results.loading')}</p>
              </div>
              <noscript><p>{t('admin.pics.needsJs')}</p></noscript>
            </div>
          ) : tab.id === 'access-info' ? (
            /* The log names photos by title, from the Pics Viewer's own data-photos (one copy on the page, not two). */
            <div class="results" data-access data-api={RESULTS_API_URL} data-locale={locale} data-messages={JSON.stringify(accessMessages)}>
              <p class="results-intro">{t('admin.access.intro')}</p>
              <div data-access-root aria-live="polite">
                <p>{t('admin.results.loading')}</p>
              </div>
              <noscript><p>{t('admin.access.needsJs')}</p></noscript>
            </div>
          ) : tab.id === 'github-issues' ? (
            <div class="results" data-issues data-api={RESULTS_API_URL} data-locale={locale} data-messages={JSON.stringify(issuesMessages)}>
              <p class="results-intro">{t('admin.issues.intro')}</p>
              <div data-issues-root aria-live="polite">
                <p>{t('admin.results.loading')}</p>
              </div>
              <noscript><p>{t('admin.issues.needsJs')}</p></noscript>
            </div>
          ) : (
            /* Gated by the admin token like the other two tabs (mountCategoryMaintenance): the list still
               travels down as data-categories-list, server-rendered same as before, so it's ready the
               instant the gate opens — the token check itself needs no data from this page. */
            <div class="results" data-category-maintenance data-api={RESULTS_API_URL} data-messages={JSON.stringify(categoryMessages)} data-categories-list={JSON.stringify(categoryRows)}>
              <p class="results-intro">{t('admin.categories.intro')}</p>
              <div data-categories-root aria-live="polite">
                <p>{t('admin.results.loading')}</p>
              </div>
              <noscript><p>{t('admin.categories.needsJs')}</p></noscript>
            </div>
          )}
        </div>
      ))}
    </div>

  </section>
</BaseLayout>

<style>
  .admin {
    padding-block: var(--space-5);
    max-width: 900px;
  }

  .admin-head { display: flex; flex-wrap: wrap; align-items: flex-end; justify-content: space-between; gap: var(--space-1) var(--space-2); }
  /* Refresh and Sign out in the top menu after Contact (Header.astro's nav-actions slot), styled like its links. */
  .nav-actions { display: contents; }
  .nav-actions[hidden] { display: none; }
  .nav-action { min-height: 44px; padding: 0; background: none; border: 0; color: var(--fg-muted); font: inherit; font-size: 1rem; cursor: pointer; }
  .nav-action:hover, .nav-action:focus-visible { color: var(--fg); }
  @media (hover: hover) { .nav-action:hover { background: var(--hover-face); box-shadow: var(--hover-bar); } }
  @media (hover: hover) and (min-width: 901px) { .nav-action:hover { padding: 0 0.4rem; margin: 0 -0.4rem; border-radius: var(--radius); } }
  @media (max-width: 900px) { .nav-action { width: 100%; padding: var(--space-2) var(--space-3); border-top: 1px solid var(--border); text-align: left; } }
  .admin h1 {
    font-size: clamp(1.8rem, 4vw, 2.6rem);
  }

  /* All six tabs fit one row on a laptop. On a phone they stack, three over three (below), so all six show at once.
     Folder tabs with a light gray border; the selected one opens onto its panel, marked by the accent along its top. */
  .tablist {
    --tab-line: #c9c8c1;
    display: flex;
    flex-direction: row;
    gap: 0.25rem;
    margin-top: var(--space-3);
    padding-top: 2px;
    border-bottom: 1px solid var(--tab-line);
    overflow-x: auto;
    overflow-y: hidden;
    scrollbar-width: thin;
  }

  .tab {
    flex-shrink: 0;
    white-space: nowrap;
    min-height: 44px;
    padding: 0.55rem 0.8rem;
    background: var(--bg-elevated);
    border: 1px solid var(--tab-line);
    border-bottom: none;
    border-radius: 6px 6px 0 0;
    color: var(--fg-muted);
    font: inherit;
    font-size: 0.95rem;
    cursor: pointer;
    transition: color 0.15s ease, background-color 0.15s ease, border-color 0.15s ease, box-shadow 0.15s ease;
  }

  .tab:hover {
    color: var(--fg);
  }

  /* The tab about to be chosen stands out: a gold-tinted face, a gold border and a gold bar along its bottom (the chosen
     tab's bar is on top, its face dark, so the two never look alike). Only where there is a pointer that hovers: on a
     touch screen a tapped tab would otherwise stay "hovered". */
  @media (hover: hover) {
    .tab:hover:not([aria-selected='true']) {
      background: var(--hover-face);
      border-color: var(--accent);
      box-shadow: inset 0 -3px 0 var(--accent);
      color: var(--fg);
    }
  }

  .tab:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: -4px;
  }

  /* A phone: two rows of three, in order (Access Info, Test Results, Lighthouse over Pics Viewer, Categories, GitHub), every
     tab its own box (folder tabs on two rows would run into each other) and a long label wrapping inside it. */
  @media (max-width: 640px) {
    .tablist {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      padding-bottom: var(--space-1);
      overflow: visible;
    }
    .tab {
      padding: 0.45rem 0.4rem;
      border-bottom: 1px solid var(--tab-line);
      border-radius: 6px;
      white-space: normal;
      text-align: center;
      line-height: 1.2;
      font-size: 0.85rem;
    }
    .tab[aria-selected='true']::after {
      display: none;
    }
  }

  /* Wider than a phone: the six share the row, a long label (the Spanish ones) taking two lines rather than pushing
     the row past the page's width. */
  @media (min-width: 641px) {
    .tablist {
      overflow-x: visible;
    }
    .tab {
      flex: 1 1 auto;
      white-space: normal;
      text-align: center;
      line-height: 1.25;
    }
  }

  .tab[aria-selected='true'] {
    position: relative;
    color: var(--fg);
    background: var(--bg);
    box-shadow: inset 0 3px 0 var(--accent);
  }

  /* The selected tab covers the row's line under it, so it opens onto its panel. */
  .tab[aria-selected='true']::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: -1px;
    height: 1px;
    background: var(--bg);
  }

  .tabpanel {
    padding-block: var(--space-3);
  }

  .tabpanel h2 {
    /* Matches every sub-heading site-wide — see .about h2's own comment. */
    font-size: 1.4rem;
    margin-bottom: var(--space-1);
  }
</style>

<style is:global>
  /* The viewer builds its own elements at run time, so its styles can't be scoped to this page's markup. */
  .results { --ok: #86d99a; --bad: #ff9b9b; }
  .results h3 { font-size: 1.4rem; margin: var(--space-3) 0 var(--space-1); }
  .results h4 { font-size: 1rem; margin: var(--space-2) 0 0.25rem; overflow-wrap: anywhere; }
  .results-intro, .results-hint, .results-count, .results-loading { color: var(--fg-muted); }
  .results-gate { display: grid; gap: var(--space-1); max-width: 26rem; }
  .admin-gate { margin-top: var(--space-3); }
  /* Buttons that edit or submit, on every tab: the Access Info controls' size (--control-text, global.css); the font is inherited. */
  :is(.pics-actions, .pics-edit-bar, .pics-remove-bar, .photo-form, .results-gate, .category-list.edit, .results-remove-toolbar, .ci-branch-dialog) button { font-size: var(--control-text); }
  /* Before signing in the page is just the token box: one column as wide as the form, centred across and between the
     header and the footer, with "ADMIN" and the "Admin" title flush with the form's left edge. */
  .admin:has(> .admin-gate:not([hidden])) { display: flex; flex-direction: column; align-items: center; justify-content: center; min-height: calc(100svh - 20rem); }
  .admin:has(> .admin-gate:not([hidden])) > * { width: min(26rem, 100%); }
  .results-gate input { min-height: 44px; padding: 0.5rem 0.75rem; background: var(--bg-elevated); color: var(--fg); border: 1px solid var(--field-border); border-radius: var(--radius); font: inherit; }
  .results-button { min-height: 44px; padding: 0.5rem 1rem; background: none; color: var(--fg); border: 1px solid var(--field-border); border-radius: var(--radius); font: inherit; cursor: pointer; }
  .results-button:hover { border-color: var(--accent); }
  /* The shared hover highlight (global.css), as on the tabs: Admin buttons, the calendar's field, days and arrows. */
  @media (hover: hover) {
    .results-button:not(:disabled):not(.danger):not(.primary):hover,
    .access-range-toggle:hover,
    .access-quick:hover { background: var(--hover-face); box-shadow: var(--hover-bar); border-color: var(--accent); }
    .results-button.primary:not(:disabled):hover { background: var(--hover-face); color: var(--fg); box-shadow: var(--hover-bar); border-color: var(--accent); }
    /* A delete button takes the same face, but keeps its red border and a red ring: still plainly a warning. */
    .results-button.danger:not(:disabled):hover { background: var(--hover-face); color: var(--fg); border-color: var(--bad); box-shadow: 0 0 0 3px color-mix(in srgb, var(--bad) 55%, transparent); filter: none; }
    .access-calendar-day:not(:disabled):not(.chosen):hover,
    .access-calendar-nav:not(:disabled):hover { background: var(--hover-face); border-color: var(--accent); }
  }
  .results-button:disabled { opacity: 0.45; cursor: not-allowed; }
  .results-button.primary { background: var(--accent); color: var(--accent-fg); border-color: var(--accent); }
  .results-toolbar { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-1); justify-content: flex-end; margin-bottom: var(--space-2); }
  .results-back { margin-right: auto; display: inline-flex; align-items: center; min-height: 44px; }
  .results-error { color: var(--bad); }
  .results-notice { margin: 0; padding: 0.6rem 0.9rem; border: 1px solid var(--accent); border-radius: var(--radius); color: var(--fg); }
  .results-badge { display: inline-block; padding: 0.1rem 0.6rem; border-radius: 999px; border: 1px solid currentColor; font-size: 0.85rem; }
  .results-badge.ok { color: var(--ok); }
  .results-badge.bad { color: var(--bad); }
  .results-runs { list-style: none; padding: 0; margin: 0; display: grid; gap: var(--space-1); }
  .results-run { display: grid; grid-template-columns: 1fr auto; gap: 0.25rem var(--space-2); align-items: center; padding: 0.75rem 1rem; min-height: 44px; background: var(--bg-elevated); border: 1px solid var(--border); border-radius: var(--radius); color: var(--fg); text-decoration: none; }
  .results-run:hover, .results-run:focus-visible { border-color: var(--accent); }
  .run-what, .run-totals { color: var(--fg-muted); font-size: 0.9rem; overflow-wrap: anywhere; }
  .results-meta { display: grid; grid-template-columns: max-content 1fr; gap: 0.25rem var(--space-2); margin: var(--space-1) 0; }
  .results-meta dt { color: var(--fg-muted); }
  .results-meta dd { margin: 0; overflow-wrap: anywhere; }
  .results-run-heading:focus { outline: none; }
  /* position: relative so that the visually-hidden "(opens in a new tab)" text of a link in a wide table (absolutely
     positioned, see global.css) is clipped by this scroll box too; otherwise it escapes it and widens the whole page. */
  .results-table-wrap { overflow-x: auto; position: relative; }
  /* Lighthouse Test Results: fourteen columns, so a little tighter than the test-run tables, and each score in a chip
     coloured on Lighthouse's own scale (90–100 good, 50–89 needs work, 0–49 poor). */
  /* A Lighthouse run's summary line (totals and performance per device) is longer than a test run's, so it takes the
     card's full width instead of the narrow right-hand column, which would otherwise grow past a phone's screen. */
  .lighthouse-run { grid-template-columns: minmax(0, 1fr) auto; }
  .lighthouse-run .run-totals { grid-column: 1 / -1; }
  .lighthouse-table { font-size: 0.85rem; font-variant-numeric: tabular-nums; }
  .lighthouse-table th, .lighthouse-table td { padding: 0.35rem 0.5rem; }
  .lighthouse-table .has-failures th { color: var(--bad); }
  .lh-score { display: inline-block; min-width: 2.2em; padding: 0.05rem 0.4rem; border-radius: 999px; text-align: center; font-weight: 600; border: 1px solid currentColor; }
  .lh-score.good { color: var(--ok); }
  .lh-score.average { color: #f0c36a; }
  .lh-score.poor { color: var(--bad); }
  .lh-bad { color: var(--bad); font-weight: 600; }
  .results-table { border-collapse: collapse; width: 100%; font-size: 0.95rem; }
  .results-table th, .results-table td { padding: 0.4rem 0.75rem; border-bottom: 1px solid var(--border); text-align: right; white-space: nowrap; }
  .results-table th:first-child { text-align: left; }
  .results-failures, .results-artifacts, .results-files { list-style: none; padding: 0; margin: 0; display: grid; gap: var(--space-2); }
  .results-failure { padding: 0.75rem 1rem; border: 1px solid var(--border); border-left: 3px solid var(--bad); border-radius: var(--radius); }
  .results-failure pre { white-space: pre-wrap; overflow-wrap: anywhere; margin: 0.5rem 0 0; font-size: 0.85rem; color: var(--fg-muted); }
  .results-artifact img { max-width: 100%; max-height: 260px; border: 1px solid var(--border); border-radius: var(--radius); }
  .results-artifact p a + a { margin-left: var(--space-2); }
  .results-features { margin: var(--space-1) 0; }
  .results-features summary { cursor: pointer; min-height: 44px; display: flex; align-items: center; }
  .results-features .has-failures th, .results-features .has-failures td { color: var(--bad); }
  .results-slowest { padding-left: 1.4rem; margin: 0; color: var(--fg-muted); }
  /* GitHub Issues: one card per issue, its title linking to GitHub; labels as chips with GitHub's own colour as a dot. */
  .issues-toolbar { margin-bottom: var(--space-2); }
  .issues-filter { display: flex; flex-wrap: wrap; gap: 0.5rem; }
  /* Access Info: a day picker and filters, the day's totals and top lists, then every entry in a table. */
  /* The day range picker (src/lib/day-range-calendar.ts), after the Astro UXDS date picker: an input-style field with
     the days as YYYY-MM-DD and a calendar icon, a Quick range dropdown beside it, and a compact month calendar (month and
     year dropdowns between arrows, the neighbouring months' days dimmed). A bottom sheet with 44px targets on a phone. */
  .access-range { position: relative; display: flex; flex-wrap: wrap; align-items: center; gap: 0.5rem; }
  .access-range-controls { display: flex; flex-wrap: wrap; gap: 0.4rem; }
  .access-range-label { font-size: var(--access-table-text); }
  .access-range-toggle, .access-quick { min-height: 38px; padding: 0.3rem 0.6rem; background: var(--bg-elevated); color: var(--fg); border: 1px solid var(--field-border); border-radius: var(--radius); font: inherit; font-size: var(--access-table-text); }
  .access-range-toggle { display: inline-flex; align-items: center; gap: 0.5rem; cursor: pointer; font-variant-numeric: tabular-nums; }
  .access-range-toggle:hover, .access-range-toggle[aria-expanded='true'] { border-color: var(--accent); }
  .access-range-icon { width: 1.05rem; height: 1.05rem; color: var(--fg-muted); }
  .access-calendar { position: absolute; top: calc(100% + 0.3rem); left: 0; z-index: 5; width: 16.5rem; padding: 0.5rem; background: var(--bg-elevated); border: 1px solid var(--field-border); border-radius: var(--radius); box-shadow: 0 6px 24px rgb(0 0 0 / 0.25); }
  .access-calendar[hidden] { display: none; }
  .access-calendar button { touch-action: manipulation; }
  .access-calendar-head { display: flex; align-items: center; gap: 0.25rem; }
  .access-calendar-selects { display: flex; flex: 1; gap: 0.25rem; }
  .access-calendar-select { flex: 1; min-width: 0; min-height: 28px; padding: 0.1rem 0.25rem; background: var(--bg); color: var(--fg); border: 1px solid var(--field-border); border-radius: var(--radius); font: inherit; font-size: var(--access-table-text); }
  .access-calendar-nav { min-width: 28px; min-height: 28px; padding: 0; background: none; color: var(--fg); border: 1px solid transparent; border-radius: var(--radius); font-size: 1.1rem; line-height: 1; cursor: pointer; }
  .access-calendar-nav:hover:not(:disabled) { border-color: var(--accent); }
  .access-calendar-nav:disabled { opacity: 0.35; cursor: default; }
  .access-calendar-grid { width: 100%; margin-top: 0.3rem; border-collapse: collapse; text-align: center; table-layout: fixed; }
  .access-calendar-grid th { padding: 0.1rem 0; color: var(--fg-muted); font-size: var(--access-table-text); font-weight: 600; text-transform: capitalize; }
  .access-calendar-grid td { padding: 1px; }
  .access-calendar-day { width: 100%; min-height: 28px; padding: 0; background: none; color: var(--fg); border: 1px solid transparent; border-radius: var(--radius); font: inherit; font-size: var(--access-table-text); font-variant-numeric: tabular-nums; cursor: pointer; }
  .access-calendar-day:focus-visible { border-color: var(--accent); }
  .access-calendar-day.outside { color: var(--fg-muted); }
  .access-calendar-day:disabled { opacity: 0.35; cursor: default; }
  .access-calendar-day.logged { font-weight: 700; text-decoration: underline; text-underline-offset: 3px; }
  .access-calendar-day.chosen { background: var(--accent); color: var(--bg); }
  .access-calendar-day[aria-current='date'] { border-color: var(--fg-muted); }
  .access-calendar-hint { margin: 0.25rem 0 0; color: var(--fg-muted); font-size: var(--access-table-text); line-height: 1.3; }
  .access-calendar-foot { display: flex; justify-content: flex-end; margin-top: 0.25rem; }
  .access-calendar-close { min-height: 28px; padding: 0.05rem 0.65rem; font-size: var(--access-table-text); }
  /* A phone: a bottom sheet across the screen, clear of the iPhone home indicator, scrolling on its own; every target at
     least 44px (Apple's and Google's touch minimum). */
  @media (max-width: 600px) {
    /* The field and the dropdowns stay at 16px on a phone: iOS zooms the page into a form field any smaller. */
    .access-range-toggle, .access-quick { min-height: 44px; font-size: 1rem; }
    .access-calendar { position: fixed; top: auto; left: 0; right: 0; bottom: 0; width: auto; max-height: 85dvh; overflow-y: auto; overscroll-behavior: contain; padding: 0.75rem 0.75rem calc(0.75rem + env(safe-area-inset-bottom)); border-radius: 14px 14px 0 0; box-shadow: 0 -8px 32px rgb(0 0 0 / 0.4); }
    .access-calendar-select { min-height: 44px; font-size: 1rem; }
    .access-calendar-nav { min-width: 44px; min-height: 44px; }
    .access-calendar-day { min-height: 44px; }
    .access-calendar-close { min-height: 44px; flex: 1; }
  }
  /* Long lists (IP addresses, countries): 50 at a time, src/lib/pager.ts. */
  .pager { display: flex; align-items: center; justify-content: center; gap: 0.75rem; margin-top: var(--space-2); }
  .pager-arrow { min-width: 44px; min-height: 44px; font-size: 1.2rem; }
  .pager-status { color: var(--fg-muted); font-variant-numeric: tabular-nums; }
  /* The two groups in one table with light gray lines: titles, then each pie with its legend, then the counts. */
  .access-groups-wrap { margin-top: var(--space-2); overflow-x: auto; position: relative; }
  .access-groups { --grid-line: #c9c8c1; width: 100%; min-width: 34rem; table-layout: fixed; border-collapse: collapse; border: 1px solid var(--grid-line); }
  .access-groups th, .access-groups td { width: 50%; padding: var(--space-2); border: 1px solid var(--grid-line); vertical-align: top; text-align: left; }
  .access-groups th { font-weight: 600; }
  .access-group-title { display: block; font-family: var(--font-display, inherit); font-size: 1.15rem; }
  .access-group-total { display: block; margin-top: 0.2rem; color: var(--fg-muted); font-size: 0.9rem; font-weight: 400; font-variant-numeric: tabular-nums; }
  .access-groups .pie-figure { margin: 0; }
  /* The Access Info tables' contents (the pies' legends, the countries, the IP addresses) share one smaller size; their
     titles keep the tables' size. */
  [data-access] { --access-table-text: 0.82rem; }
  .access-name { overflow-wrap: anywhere; }
  .access-times { color: var(--fg-muted); font-variant-numeric: tabular-nums; }
  /* Each list's pie (src/lib/pie-chart.ts): the dark steps of the dataviz reference palette's first four categorical
     slots, its violet for the fifth, and a neutral gray for "Other", validated as a ring against --bg; a 2px gap in
     --bg between slices. */
  .access-groups { --pie-1: #3987e5; --pie-2: #d95926; --pie-3: #199e70; --pie-4: #c98500; --pie-5: #9085e9; --pie-other: #6e6d67; }
  .pie-figure { margin: var(--space-2) 0 0; display: grid; gap: var(--space-2); }
  .pie-plot { position: relative; width: min(13rem, 100%); justify-self: center; }
  .pie { display: block; width: 100%; height: auto; overflow: visible; }
  .pie-slice { stroke: var(--bg); stroke-width: 2px; stroke-linejoin: round; cursor: default; transition: filter 120ms; }
  .pie-slice:hover, .pie-slice:focus-visible { filter: brightness(1.25); outline: none; }
  .pie-slice:focus-visible { stroke: var(--fg); }
  .pie-slot-1 { fill: var(--pie-1); background: var(--pie-1); }
  .pie-slot-2 { fill: var(--pie-2); background: var(--pie-2); }
  .pie-slot-3 { fill: var(--pie-3); background: var(--pie-3); }
  .pie-slot-4 { fill: var(--pie-4); background: var(--pie-4); }
  .pie-slot-5 { fill: var(--pie-5); background: var(--pie-5); }
  .pie-other { fill: var(--pie-other); background: var(--pie-other); }
  .pie-legend { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.35rem; font-size: var(--access-table-text); }
  .pie-legend li { display: grid; grid-template-columns: 0.75rem minmax(0, 1fr) auto; gap: 0.5rem; align-items: center; }
  .pie-legend-label { overflow-wrap: break-word; min-width: 0; }
  .pie-legend-value { color: var(--fg-muted); font-variant-numeric: tabular-nums; white-space: nowrap; }
  .pie-swatch { width: 0.75rem; height: 0.75rem; border-radius: 2px; }
  .pie-touch-hint { display: none; }
  /* A phone: the two pies side by side, smaller, with no sideways scrolling; each legend hidden from sight (still read
     out, and every slice is named) since a tap on a slice shows its numbers in the tooltip. */
  @media (max-width: 600px) {
    .access-groups-wrap { overflow: visible; }
    .access-groups { min-width: 0; }
    .access-groups th, .access-groups td { padding: var(--space-1); }
    .pie-plot { width: min(9rem, 100%); }
    .pie-legend { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
    .pie-tooltip { min-width: 8rem; max-width: 11rem; font-size: 0.8rem; }
    .pie-touch-hint { display: block; margin: var(--space-1) 0 0; color: var(--fg-muted); font-size: 0.8rem; text-align: center; }
  }
  /* The world map (src/lib/world-map.ts): one blue, darkest for the fewest visits to lightest for the most (the dataviz
     reference palette's blue steps 600 → 300, validated as an ordered scale against --bg); no visits, a quiet gray. */
  /* The map's own table: the same light gray lines as the pies' one, one column (it shrinks with the page, no scroll). */
  .access-map { margin-top: var(--space-2); }
  .access-map-table { --grid-line: #c9c8c1; width: 100%; border-collapse: collapse; border: 1px solid var(--grid-line); }
  .access-map-table th, .access-map-table td { padding: var(--space-2); border: 1px solid var(--grid-line); vertical-align: top; text-align: left; }
  .access-map-table th { font-weight: 600; }
  /* Visits by IP address, under the map: same lines; scrolls sideways on its own on a narrow screen. */
  .access-ips { margin-top: var(--space-3); }
  .access-ips-wrap { overflow-x: auto; }
  .access-ip-table tbody th { font-weight: 400; font-family: var(--font-mono, ui-monospace, monospace); overflow-wrap: anywhere; }
  .access-ip-table .access-num { text-align: right; font-variant-numeric: tabular-nums; }
  /* Smaller rows and column headers (the title above them keeps the tables' size), with tighter cells to match. */
  .access-ip-table tbody, .access-ip-table thead tr + tr th { font-size: var(--access-table-text); }
  .access-ip-table tbody th, .access-ip-table tbody td, .access-ip-table thead tr + tr th { padding: 0.35rem 0.6rem; }
  .map-figure { margin: 0; }
  .map-plot { position: relative; }
  .world-map { display: block; width: 100%; height: auto; }
  .map-country { stroke: var(--bg); stroke-width: 0.6px; stroke-linejoin: round; transition: filter 120ms; }
  .map-country:hover, .map-country:focus-visible { filter: brightness(1.3); outline: none; }
  .map-highlight { fill: none; stroke: var(--fg); stroke-width: 1.5px; stroke-linejoin: round; pointer-events: none; }
  .map-band-1 { fill: #184f95; background: #184f95; }
  .map-band-2 { fill: #256abf; background: #256abf; }
  .map-band-3 { fill: #3987e5; background: #3987e5; }
  .map-band-4 { fill: #6da7ec; background: #6da7ec; }
  .map-band-5 { fill: #9ec5f4; background: #9ec5f4; }
  .map-none { fill: #2a2926; background: #2a2926; }
  .map-legend { display: flex; flex-wrap: wrap; gap: 0.4rem 1rem; margin: var(--space-1) 0; font-size: var(--access-table-text); color: var(--fg-muted); font-variant-numeric: tabular-nums; }
  .map-legend-item { display: inline-flex; align-items: center; gap: 0.4rem; }
  /* One list down the page, most accessed first (byCountry's order): each country's counts beside its name. */
  /* Flush left, under the legend: no indent, and each row's hover highlight reaches out past the names by its own
     padding, so the names line up with the legend's first band. */
  /* Two aligned columns: the names, then their counts about 1rem after the longest name (each row spans both, so it
     still highlights as one). */
  .map-list { display: grid; grid-template-columns: max-content max-content; column-gap: 1rem; width: fit-content; max-width: 100%; margin: 0; padding-left: 0; list-style: none; }
  .map-list > li { grid-column: 1 / -1; display: grid; grid-template-columns: subgrid; column-gap: 1rem; row-gap: 0; }
  /* A blank line before and after the list of countries, setting it apart from the legend above and the note below. */
  .map-list-box { position: relative; margin-block: 1lh; font-size: var(--access-table-text); }
  /* The note about visits without a country closes the cell: no blank line after it. */
  .map-unplaced { margin-bottom: 0; font-size: var(--access-table-text); }
  .map-list li { cursor: default; border-radius: 4px; padding: 0.1rem 0.3rem; margin-inline: -0.3rem; }
  .map-list li:hover, .map-list li:focus-visible { background: var(--bg-elevated); outline: 1px solid var(--border); }
  .pie-tooltip.map-city-tooltip { width: max-content; min-width: 16rem; max-width: min(26rem, 100%); }
  .map-city-list { margin: 0.25rem 0 0; padding-left: 1.2rem; display: grid; gap: 0.15rem; }
  .map-city-list li { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: var(--space-2); }
  .map-city-list .access-times { white-space: nowrap; }
  /* One tooltip per pie: the number leads, the name follows, keyed by a short stroke of the slice's color. */
  .pie-tooltip { position: absolute; left: var(--tip-x, 0); top: var(--tip-y, 0); z-index: 2; pointer-events: none; display: grid; gap: 0.15rem; min-width: 9rem; max-width: 16rem; padding: 0.5rem 0.7rem; background: var(--bg-elevated); border: 1px solid var(--border); border-radius: var(--radius); box-shadow: 0 6px 18px rgb(0 0 0 / 0.45); font-size: 0.85rem; }
  .pie-tooltip[hidden] { display: none; }
  .pie-tooltip strong { color: var(--fg); font-variant-numeric: tabular-nums; }
  .pie-tip-label { display: flex; align-items: center; gap: 0.4rem; color: var(--fg-muted); overflow-wrap: break-word; }
  .pie-key { flex: none; width: 0.9rem; height: 3px; border-radius: 2px; }
  .issues-new { display: inline-flex; align-items: center; text-decoration: none; }
  .issues-all { display: inline-flex; align-items: center; min-height: 44px; }
  .issue-list { list-style: none; padding: 0; margin: 0; display: grid; gap: 0.25rem; }
  .issue { display: grid; gap: 0.3rem; padding: 0.7rem 1rem; background: var(--bg-elevated); border: 1px solid var(--border); border-radius: var(--radius); }
  .issue-head { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: 0.25rem var(--space-1); }
  .issue-title { font-weight: 600; overflow-wrap: anywhere; }
  .issue-state { color: var(--fg-muted); font-size: 0.8rem; }
  .issue-meta { margin: 0; color: var(--fg-muted); font-size: 0.85rem; overflow-wrap: anywhere; }
  .issue-labels { list-style: none; padding: 0; margin: 0; display: flex; flex-wrap: wrap; gap: 0.35rem; }
  .issue-label { display: inline-flex; align-items: center; gap: 0.35rem; padding: 0.05rem 0.55rem; border: 1px solid var(--border); border-radius: 999px; font-size: 0.8rem; }
  .issue-label::before { content: ''; width: 0.6rem; height: 0.6rem; border-radius: 50%; background: var(--label, var(--fg-muted)); }
  .pics-summary { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: var(--space-1) var(--space-2); margin-bottom: var(--space-1); }
  .pics-summary .results-count { margin: 0; }
  .pics-actions { display: flex; flex-wrap: wrap; gap: var(--space-1); margin-left: auto; }
  .pics-action { display: inline-flex; align-items: center; gap: 0.5rem; }
  .pics-status { min-height: 1.4em; margin: 0 0 var(--space-1); color: var(--fg-muted); font-size: 0.9rem; }
  .pics-list { list-style: none; padding: 0; margin: 0; display: grid; gap: 0.25rem; }
  .pic { position: relative; }
  /* Thumbnail | title, Home background badge (when set), category and the file's path, one under the other | the
     file's details (camera, date taken, size, copyright). The text column has the same width in every row — wide
     enough for a file's path on one line — so every row's divider sits at the same place, evenly spaced from the text,
     and the details take the rest of the row. */
  .pic-link { display: grid; grid-template-columns: 96px minmax(0, 18rem) minmax(12rem, 1fr); gap: 0.15rem var(--space-2); align-content: center; align-items: start; padding: 0.6rem 1rem; min-height: 44px; background: var(--bg-elevated); border: 1px solid var(--border); border-radius: var(--radius); color: var(--fg); text-decoration: none; }
  .pic-title, .pic-category, .pic-badges, .pic-key { grid-column: 2; }
  .pic-title { font-weight: 600; overflow-wrap: anywhere; }
  .pic-category { color: var(--fg-muted); font-size: 0.85rem; }
  .pic-badges .results-badge { font-weight: normal; }
  .pic-key { color: var(--fg-muted); font-size: 0.8rem; overflow-wrap: anywhere; }
  .pic-details { grid-column: 3; grid-row: 1 / span 4; align-self: center; padding-left: var(--space-2); border-left: 1px solid var(--border); font-size: 0.85rem; min-width: 0; }
  /* A phone has no room for a third column: the details go under the file's path instead. */
  @media (max-width: 640px) {
    .pic-link { grid-template-columns: 96px minmax(0, 1fr); }
    .pic-details { grid-column: 1 / -1; grid-row: auto; margin-top: 0.5rem; padding: 0.5rem 0 0; border-left: none; border-top: 1px solid var(--border); }
  }
  .pic-thumb { grid-row: 1 / span 4; grid-column: 1; align-self: center; display: grid; place-items: center; width: 96px; height: 96px; }
  .pic-thumb img { display: block; border-radius: 2px; background: var(--bg); }
  .pic-thumb-none { display: grid; place-items: center; width: 96px; height: 96px; padding: 0.25rem; border: 1px dashed var(--field-border); border-radius: 2px; color: var(--fg-muted); font-size: 0.75rem; text-align: center; }
  .pic-details-note { margin: 0; color: var(--fg-muted); }
  .pic-facts { display: grid; grid-template-columns: max-content 1fr; gap: 0.25rem 0.75rem; margin: 0; }
  .pic-facts dt { color: var(--fg-muted); }
  .pic-facts dd { margin: 0; overflow-wrap: anywhere; }
  .photo-form { margin: var(--space-2) 0 var(--space-3); padding: var(--space-2) var(--space-3); }
  .photo-form { overflow-wrap: anywhere; } /* the written path is one long word */
  .photo-form h3 { margin-top: 0; }
  .photo-form > .results-hint { margin-bottom: var(--space-2); }
  .photo-form-fields { display: grid; grid-template-columns: minmax(0, 1fr); gap: var(--space-2); max-width: 34rem; }
  .photo-form-field { display: grid; gap: 0.25rem; min-width: 0; }
  .photo-form-field .results-hint, .photo-form .results-hint { margin: 0; font-size: 0.9rem; }
  .photo-form input:not([type='checkbox']), .photo-form select { min-height: 44px; padding: 0.5rem 0.75rem; background: var(--bg); color: var(--fg); border: 1px solid var(--field-border); border-radius: var(--radius); font: inherit; width: 100%; box-sizing: border-box; }
  .photo-form input[type='file'] { padding: 0.4rem 0.5rem; }
  .photo-form-check { display: flex; align-items: center; gap: 0.5rem; min-height: 44px; }
  .photo-form-check input { width: 1.25rem; height: 1.25rem; accent-color: var(--accent); }
  .photo-form-extracted { padding: var(--space-1) var(--space-2); border: 1px solid var(--border); border-radius: var(--radius); display: grid; gap: var(--space-1); }
  .photo-form-extracted[hidden] { display: none; }
  .photo-form-extracted h4 { margin: 0; }
  .photo-form-buttons { display: flex; flex-wrap: wrap; gap: var(--space-1); }
  .photo-form-entry { margin: 0; padding: var(--space-1) var(--space-2); background: var(--bg); border: 1px solid var(--border); border-radius: var(--radius); overflow-x: auto; font-size: 0.85rem; }
  .photo-form-done:focus { outline: none; }
  .results-button.danger { background: var(--bad); color: #1a0505; border-color: var(--bad); }
  .results-button[aria-pressed='true'] { border-color: var(--accent); }
  /* Production: the tabs marked above show no buttons at all (the viewers still build them; they are just never shown). */
  [data-buttons-hidden] button { display: none !important; }
  /* Edit mode is red on every tab, as on the site's own pages (the page editor): the bar of the edit under way, the
     button that started it, the forms, the fields, checkboxes, switches and chosen rows (the rules below). */
  .admin { --edit-red: #e5484d; }
  .pics-remove-bar, .pics-edit-bar { display: grid; gap: var(--space-1); margin: 0 0 var(--space-1); padding: var(--space-1) var(--space-2); }
  .pics-remove-bar, .pics-edit-bar, .photo-form { border: 1px solid var(--edit-red); border-radius: var(--radius); background: var(--bg-elevated); box-shadow: 0 0 0 3px #e5484d59; }
  :is(.pics-edit-bar, .pics-remove-bar, .photo-form, .category-list.edit) .results-button, .pics-actions [aria-pressed='true'] { border-color: var(--edit-red); }
  /* Filled: a deeper red, so white text on it stays readable (4.5:1 and more). */
  :is(.pics-edit-bar, .pics-remove-bar, .photo-form, .category-list.edit) .primary { background: #c62a2f; border-color: #c62a2f; color: #fff; }
  :is(.photo-form, .category-list.edit, .pics-edit-controls) :is(input, select) { border-color: var(--edit-red); }
  .admin :is(.pics-edit-bar, .pics-remove-bar, .photo-form, .category-list.edit) .results-button:not(:disabled):not(.danger):hover, .admin .pics-actions .results-button[aria-pressed='true']:not(:disabled):hover { background: #e5484d4d; box-shadow: inset 0 -3px 0 var(--edit-red); border-color: var(--edit-red); }
  .pics-remove-count { margin: 0; color: var(--fg); }
  .pics-remove-warning { margin: 0; color: var(--fg); font-weight: 600; }
  .pics-remove-warning:focus { outline: none; }
  .pics-remove-named { margin: 0; padding-left: 1.25rem; color: var(--fg-muted); overflow-wrap: anywhere; }
  .pics-remove-buttons { display: flex; flex-wrap: wrap; gap: var(--space-1); }
  .pics-edit-count { margin: 0; color: var(--fg); }
  .pics-edit-controls { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-1); }
  .pics-edit-controls select { min-height: 44px; padding: 0.4rem 0.6rem; background: var(--bg); color: var(--fg); border: 1px solid var(--field-border); border-radius: var(--radius); font: inherit; }
  .pics-list.selecting .pic { display: grid; grid-template-columns: 44px minmax(0, 1fr); align-items: center; column-gap: 0.25rem; }
  .pics-list.hero .pic { grid-template-columns: 3.5rem minmax(0, 1fr); }
  .pic-select { display: grid; place-items: center; width: 44px; min-height: 44px; cursor: pointer; }
  .pic-check { width: 1.4rem; height: 1.4rem; accent-color: var(--edit-red); cursor: pointer; }
  /* Remove Results (Test Results tab): the same bar as Remove Photos, and a checkbox beside each run while choosing. */
  .results-remove-toolbar { justify-content: flex-start; }
  .results-runs.choosing li { display: grid; grid-template-columns: auto minmax(0, 1fr); align-items: center; gap: var(--space-1); }
  .run-check { width: 1.4rem; height: 1.4rem; accent-color: var(--edit-red); cursor: pointer; }
  /* Run in CI's branch dialog (src/lib/results-remove.ts): opened above everything, in the page's own colors. */
  .ci-branch-dialog { max-width: min(32rem, calc(100vw - 2rem)); padding: var(--space-2); border: 1px solid var(--border, currentColor); border-radius: var(--radius); background: var(--bg-elevated); color: var(--fg); }
  .ci-branch-dialog::backdrop { background: rgb(0 0 0 / 0.55); }
  .ci-branch-dialog form { display: grid; gap: var(--space-1); }
  .ci-branch-dialog h3 { margin: 0; }
  .ci-branch-select { font: inherit; padding: 0.4rem; max-width: 100%; }
  .ci-branch-warning:empty { display: none; }
  .ci-branch-warning { margin: 0; color: var(--fg); font-weight: 600; }
  .pic.selected .pic-link, .pic.changed .pic-link, .category-list.edit .category-row-body { border-color: var(--edit-red); }
  /* Home Background: an on/off switch, and a dashed frame on a row changed but not yet saved (both red: edit mode, below). */
  .pic-switch { appearance: none; position: relative; width: 2.75rem; height: 1.5rem; margin: 0; border-radius: 1rem; background: var(--border); transition: background 0.15s; }
  .pic-switch::before { content: ''; position: absolute; top: 0.2rem; left: 0.2rem; width: 1.1rem; height: 1.1rem; border-radius: 50%; background: var(--fg); transition: transform 0.15s; }
  .pic-switch:checked { background: var(--edit-red); }
  .pic-switch:checked::before { transform: translateX(1.25rem); }
  .pic-switch:focus-visible { outline: 2px solid var(--edit-red); outline-offset: 2px; }
  .pic.changed .pic-link { border-style: dashed; }
  .pics-more { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: var(--space-1) var(--space-2); margin-top: var(--space-2); }
  .pics-shown { margin: 0; color: var(--fg-muted); }
  .pics-shown:focus { outline: none; }
  /* Category Maintenance's own list — the same visual language as the Pics Viewer's (.pics-summary,
     .pics-actions, .results-button, .pics-edit-bar, .pics-remove-bar are all reused as-is above), but a
     plain row instead of .pic-link's thumbnail grid: a category has no picture of its own. */
  .category-list { list-style: none; padding: 0; margin: 0; display: grid; gap: 0.25rem; }
  .category-row-body { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 0.5rem 1rem; padding: 0.6rem 1rem; min-height: 44px; background: var(--bg-elevated); border: 1px solid var(--border); border-radius: var(--radius); }
  /* .remove specifically, not just .selecting: Edit mode's rows have no checkbox to fill this grid's
     first (44px) column — a lone, ungridded .category-row-body would land in it by itself, squeezed
     to 44px wide, rather than spanning both columns as a plain flex row still does by default. */
  .category-list.selecting.remove .category-row { display: grid; grid-template-columns: 44px minmax(0, 1fr); align-items: center; column-gap: 0.25rem; }
  .category-row.selected .category-row-body { border-color: var(--bad); }
  .category-info { display: flex; flex-direction: column; gap: 0.15rem; min-width: 0; }
  .category-name { display: flex; align-items: center; gap: 0.5rem; font-weight: 600; overflow-wrap: anywhere; }
  .category-meta { color: var(--fg-muted); font-size: 0.85rem; }
  /* Each logical group (slug + Hidden, then one row per language pairing its Name with its own
     Description, then Save) gets its own row, so a row's fields never wrap into an unrelated one —
     .category-edit-row wraps within itself instead. */
  .category-edit-fields { display: flex; flex-direction: column; gap: 0.6rem; width: 100%; }
  .category-edit-row { display: flex; flex-wrap: wrap; align-items: flex-end; gap: 0.5rem 0.75rem; }
  /* The last row (Save + status) is the only one with no labels above its content, so it centers instead. */
  .category-edit-fields > .category-edit-row:last-child { align-items: center; }
  .category-field-inline { display: flex; flex-direction: column; gap: 0.15rem; }
  .category-field-inline label { font-size: 0.8rem; color: var(--fg-muted); }
  .category-field-inline input { min-height: 40px; padding: 0.3rem 0.6rem; background: var(--bg); color: var(--fg); border: 1px solid var(--field-border); border-radius: var(--radius); font: inherit; width: 12rem; max-width: 100%; box-sizing: border-box; }
  /* A description runs much longer than a name, so its box is twice as wide, then 40% wider still. */
  .category-field-inline.wide input { width: 33.6rem; }
  .category-edit-fields > .results-hint { margin: -0.35rem 0 0; }
  .category-edit-status { color: var(--fg-muted); font-size: 0.85rem; min-height: 1.2em; }
  @media (max-width: 640px) {
    /* Narrow enough that two side-by-side fields would otherwise squeeze to unreadable widths — stack each
       row's fields instead, full width. */
    .category-edit-row { flex-direction: column; align-items: stretch; gap: 0.5rem; }
    /* .wide repeated: it must match the desktop rule's own specificity to actually override it here. */
    .category-field-inline input, .category-field-inline.wide input { width: 100%; }
  }
</style>

<script>
  import { mountResultsViewer } from '../../lib/results-viewer';

  import { mountPicsViewer } from '../../lib/pics-viewer';
  import { mountCategoryMaintenance } from '../../lib/category-maintenance';
  import { mountAdminActions } from '../../lib/admin-actions';
  import { mountAdminGate } from '../../lib/admin-gate';
  import { mountIdleTimeout } from '../../lib/admin-session';

  declare global {
    interface Window {
      // Set the first (and only intended) time this page's script runs in this tab — see below.
      __adminMounted?: boolean;
    }
  }

  // Astro bundles this script to one stable URL, so the browser's module cache only ever evaluates
  // it once per tab; `astro:page-load` (not a direct top-level call) is what re-runs it on every
  // later view-transition navigation, the same as Header/Gallery/contact.astro. Admin is different
  // from those, though: mountResultsViewer/mountPicsViewer/mountAdminActions/mountIdleTimeout each
  // attach their own listeners to `window`/`document` with no way to tear them down, since normally
  // a page load only ever happens once per visit. Simply re-running them on a second SPA visit to
  // this page (e.g. clicking a nav link away, then the browser Back button) would stack duplicates
  // of every one of them rather than replacing them. Nothing in the site currently links to
  // /admin/, so the only way back here is that Back button — cheaply and safely handled by forcing
  // a real reload the first time it happens, which is no worse than what every visit here already
  // did before view transitions existed, rather than auditing/adding teardown to four already
  // well-tested library files for a private, owner-only page.
  function initAdmin() {
    if (window.__adminMounted) {
      location.reload();
      return;
    }
    window.__adminMounted = true;

    const viewer = document.querySelector<HTMLElement>('[data-results]');
    if (viewer) mountResultsViewer(viewer, viewer.closest<HTMLElement>('[role="tabpanel"]')!);
    // The Lighthouse viewer's code is loaded the first time its tab is shown, not with the page: most visits never
    // open it (the same reasoning as the Pics Viewer's bulk actions). It then behaves exactly as if mounted at load.
    // GitHub Issues is loaded the same way.
    const mountWhenShown = (selector: string, load: () => Promise<(container: HTMLElement, panel: HTMLElement) => void>) => {
      const container = document.querySelector<HTMLElement>(selector);
      const panel = container?.closest<HTMLElement>('[role="tabpanel"]');
      if (!container || !panel) return;
      let loading = false;
      const loadWhenShown = () => {
        if (loading || panel.hidden) return;
        loading = true;
        watcher.disconnect();
        void load().then((mount) => mount(container, panel));
      };
      const watcher = new MutationObserver(loadWhenShown);
      watcher.observe(panel, { attributes: true, attributeFilter: ['hidden'] });
      setTimeout(loadWhenShown, 0); // once the tabs have applied the address (a link straight to #lighthouse-results)
    };
    mountWhenShown('[data-lighthouse]', () => import('../../lib/lighthouse-viewer').then((module) => module.mountLighthouseViewer));
    mountWhenShown('[data-issues]', () => import('../../lib/issues-viewer').then((module) => module.mountIssuesViewer));
    mountWhenShown('[data-access]', () => import('../../lib/access-viewer').then((module) => module.mountAccessViewer));
    mountIdleTimeout();
    const gate = document.querySelector<HTMLElement>('[data-admin-gate]');
    const tabsRoot = document.querySelector<HTMLElement>('[data-tabs]');
    if (gate && tabsRoot) mountAdminGate(gate, tabsRoot);
    const actions = document.querySelector<HTMLElement>('[data-admin-actions]');
    if (actions) mountAdminActions(actions);
    const pics = document.querySelector<HTMLElement>('[data-pics]');
    if (pics) mountPicsViewer(pics, pics.closest<HTMLElement>('[role="tabpanel"]')!);
    const categoryMaintenance = document.querySelector<HTMLElement>('[data-category-maintenance]');
    if (categoryMaintenance) mountCategoryMaintenance(categoryMaintenance, categoryMaintenance.closest<HTMLElement>('[role="tabpanel"]')!);

    // Tabs pattern (WAI-ARIA): one tab in the tab order at a time; arrow keys, Home and End move between
    // tabs; the selected tab is shown in the URL (#pics-viewer) so it can be linked to.
    document.querySelectorAll<HTMLElement>('[data-tabs]').forEach((root) => {
      const tabs = Array.from(root.querySelectorAll<HTMLElement>('[role="tab"]'));
      const panels = tabs.map((tab) => document.getElementById(tab.getAttribute('aria-controls') ?? '') as HTMLElement);
      const idOf = (tab: HTMLElement) => tab.id.replace(/^tab-/, '');

      function select(index: number, { focus = false, updateHash = false } = {}) {
        tabs.forEach((tab, i) => {
          const selected = i === index;
          tab.setAttribute('aria-selected', String(selected));
          tab.tabIndex = selected ? 0 : -1;
          panels[i].hidden = !selected;
        });
        if (focus) tabs[index].focus();
        // The tab row scrolls sideways on a narrow screen: keep the selected tab in sight.
        tabs[index].scrollIntoView({ block: 'nearest', inline: 'nearest' });
        if (updateHash) history.replaceState(null, '', `#${idOf(tabs[index])}`);
      }

      // `#test-results/run/<id>` (a run inside the tab) selects the same tab as `#test-results`.
      const fromHash = () => tabs.findIndex((tab) => idOf(tab) === location.hash.slice(1).split('/')[0]);

      tabs.forEach((tab, index) => {
        tab.addEventListener('click', () => select(index, { updateHash: true }));
        tab.addEventListener('keydown', (event) => {
          const last = tabs.length - 1;
          const target = { ArrowRight: index === last ? 0 : index + 1, ArrowLeft: index === 0 ? last : index - 1, Home: 0, End: last }[event.key];
          if (target === undefined) return;
          event.preventDefault();
          select(target, { focus: true, updateHash: true });
        });
      });

      if (fromHash() >= 0) select(fromHash());
      window.addEventListener('hashchange', () => fromHash() >= 0 && select(fromHash()));
    });
  }

  document.addEventListener('astro:page-load', initAdmin);
</script>
