---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Gallery from '../../components/Gallery.astro';
import CategoryCard from '../../components/CategoryCard.astro';
import GeoRedirect from '../../components/GeoRedirect.astro';
import { VISIBLE_CATEGORIES } from '../../config/categories';
import { HERO_SRCSET, photoSrcSet, photoVariant } from '../../config/photos';
import { SITE } from '../../config/site';
import { notFound } from '../../lib/not-found';
import { getPhotos } from '../../lib/photo-entries';
import {
  DEFAULT_LOCALE,
  getLocale,
  getSortedVisibleCategories,
  isLangParam,
  localeStaticParams,
  localizePath,
  useTranslations,
} from '../../i18n';

// Rendered when requested, from the entries in R2 (`output: 'server'`, see astro.config.mjs); the tests' snapshot build makes it static.
export const getStaticPaths = localeStaticParams;

if (!isLangParam(Astro.params.lang)) return notFound();

const locale = getLocale(Astro);
const t = useTranslations(locale);

// Structured data for search engines: the website and the photography business behind it.
const homeUrl = new URL(localizePath('/', locale), SITE.url).href;
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: t('site.title'),
    url: homeUrl,
    inLanguage: locale,
    description: t('site.description'),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'ProfessionalService',
    name: t('site.title'),
    url: homeUrl,
    image: new URL('/og-image.png', SITE.url).href,
    description: t('site.description'),
    email: SITE.email,
    address: {
      '@type': 'PostalAddress',
      addressLocality: SITE.address.locality,
      addressRegion: SITE.address.region,
      addressCountry: SITE.address.country,
    },
    contactPoint: {
      '@type': 'ContactPoint',
      email: SITE.email,
      contactType: 'customer service',
      availableLanguage: ['English', 'Spanish'],
    },
    sameAs: Object.values(SITE.social).filter(Boolean),
  },
];

const visibleSlugs = new Set(VISIBLE_CATEGORIES.map((c) => c.slug));

const allPhotos = await getPhotos();
const featured = allPhotos
  .filter((p) => p.data.featured && visibleSlugs.has(p.data.category))
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 8);

const sortedCategories = getSortedVisibleCategories(locale);

const covers = sortedCategories.map((category) => {
  const inCategory = allPhotos
    .filter((p) => p.data.category === category.slug)
    .sort((a, b) => a.data.order - b.data.order);
  return { category, cover: inCategory[0] };
});

// The hero's crossfade. An admin can explicitly choose which photos to use, from any category, through the
// Admin page's Pics Viewer (Edit Photos > Home Background, `heroBackground` — see its own comment in
// photo-manifest.ts): an explicit choice always wins, bypassing the rule below entirely. With no explicit
// choice, it falls back to these categories by design (wide, scene-setting photos suit a full-bleed
// background; a close-up portrait or a macro shot doesn't read the same way at that size and crop);
// featured photos among them when there are any (a deliberate choice of what to lead with), otherwise just
// whatever's curated first — so the hero never has nothing to show as long as either category has photos.
const HERO_CATEGORIES = new Set(['landscape', 'cityscape']);
const chosenHero = allPhotos.filter((p) => p.data.heroBackground).sort((a, b) => a.data.order - b.data.order);
const heroCandidates = allPhotos.filter((p) => HERO_CATEGORIES.has(p.data.category));
const featuredHero = heroCandidates.filter((p) => p.data.featured).sort((a, b) => a.data.order - b.data.order);
const heroPhotos = (chosenHero.length > 0 ? chosenHero : featuredHero.length > 0 ? featuredHero : heroCandidates.slice().sort((a, b) => a.data.order - b.data.order)).slice(0, 3);
---

<BaseLayout title={t('site.title')} description={t('site.description')} jsonLd={jsonLd}>
  {locale === DEFAULT_LOCALE && <GeoRedirect />}
  <section class="hero">
    {heroPhotos.length > 0 && (
      <div class="hero-media" aria-hidden="true">
        {heroPhotos.map((photo, index) => {
          const full = photoVariant(photo.data.photo, 'full');
          return (
            <img
              src={full.src}
              srcset={photoSrcSet(photo.data.photo, HERO_SRCSET)}
              sizes="100vw"
              width={full.width}
              height={full.height}
              alt=""
              class:list={{ 'is-active': index === 0 }}
              loading={index === 0 ? 'eager' : 'lazy'}
              fetchpriority={index === 0 ? 'high' : undefined}
              decoding="async"
            />
          );
        })}
        <div class="hero-scrim"></div>
      </div>
    )}
    <div class="wrap hero-content">
      <p class="eyebrow">{t('site.tagline')}</p>
      <h1 data-edit-key="home.heroTitle">{t('home.heroTitle')}</h1>
      <p class="hero-copy" data-edit-key="home.heroCopy">{t('home.heroCopy')}</p>
      <div class="hero-actions">
        <a class="btn btn-primary" href={localizePath('/work/all/', locale)}>{t('home.viewWork')}</a>
        <a class="btn" href={localizePath('/contact/', locale)}>{t('home.bookSession')}</a>
      </div>
    </div>
  </section>

  {featured.length > 0 && (
    <section class="wrap section" data-reveal>
      <h2>{t('home.featured')}</h2>
      <Gallery photos={featured} />
    </section>
  )}

  <section class="wrap section" id="explore-by-category" data-reveal>
    <h2 data-edit-key="home.exploreByCategory">{t('home.exploreByCategory')}</h2>
    <div class="category-grid">
      {covers.map(({ category, cover }) => (
        <CategoryCard category={category} cover={cover} />
      ))}
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    position: relative;
    display: flex;
    align-items: flex-start;
    /* Shorter than it was (88svh): an admin can now set any photo as this background (Pics Viewer's
       Home Background, any category, not just wide landscape/cityscape shots — see HERO_CATEGORIES'
       own comment above), and object-fit: cover below crops harder the further the frame's own
       aspect ratio strays from the photo's — a tall, short-of-full-height frame like this one crops
       far less aggressively across a wider range of photos, portrait ones included, than a
       near-full-height one did. */
    min-height: 70svh;
    overflow: hidden;
  }

  .hero-media {
    position: absolute;
    inset: 0;
  }

  .hero-media img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    /* Monochrome by design: a full-color photo competing with the accent color and the rest of the
       page's palette read as busier than a background image should; grayscale keeps it atmospheric
       without competing for attention. */
    filter: grayscale(1);
    opacity: 0;
    transition: opacity 2.5s ease;
  }

  .hero-media img.is-active {
    opacity: 1;
  }

  .hero-scrim {
    position: absolute;
    inset: 0;
    /* Strongest where the text sits (top-left, since the content block moved there to sit flush
       with the tagline at the same height as the About page's eyebrow), fading out toward the
       bottom so the photo itself still reads clearly lower down. */
    background: linear-gradient(to bottom, rgba(10, 10, 9, 0.92) 15%, rgba(10, 10, 9, 0.45) 60%, rgba(10, 10, 9, 0.55));
  }

  .hero-content {
    position: relative;
    /* padding-block-start matches .about's own padding-block: the tagline (this block's first
       child, right above the heading) sits at exactly the same height as the About page's eyebrow. */
    padding-block: var(--space-5) var(--space-6);
    max-width: 760px;
  }

  .hero h1 {
    font-size: clamp(2.2rem, 6vw, 4rem);
    margin-block: 0.5rem 1rem;
  }

  .hero-copy {
    font-size: 1.1rem;
    max-width: 56ch;
  }

  .hero-actions {
    display: flex;
    gap: var(--space-2);
    margin-top: var(--space-3);
    flex-wrap: wrap;
  }

  .section {
    padding-block: var(--space-6);
  }

  #explore-by-category {
    /* The header is sticky, so a plain #explore-by-category jump (from the Portfolio menu, or any
       link to this anchor) would tuck the heading right under it; this keeps it clear. */
    scroll-margin-top: 5.5rem;
  }

  .section h2 {
    margin-bottom: var(--space-4);
    /* Matches every other sub-heading site-wide (.about h2, the Admin tabs, category card names): see
       the .about h2 rule for the shared reasoning. */
    font-size: 1.4rem;
  }

  .category-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: var(--space-3);
  }
</style>

<script>
  import { initHeroCrossfade } from '../../lib/hero-crossfade';

  // Not a direct top-level call: this script is bundled to one stable URL, so the browser's module
  // cache only ever evaluates it once per tab — see the fuller explanation in Header.astro's script.
  document.addEventListener('astro:page-load', () => initHeroCrossfade(document));
</script>
