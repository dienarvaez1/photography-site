---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Gallery from '../../components/Gallery.astro';
import CategoryCard from '../../components/CategoryCard.astro';
import GeoRedirect from '../../components/GeoRedirect.astro';
import { VISIBLE_CATEGORIES } from '../../config/categories';
import { SITE } from '../../config/site';
import {
  DEFAULT_LOCALE,
  getLocale,
  getSortedVisibleCategories,
  localeStaticParams,
  localizePath,
  useTranslations,
} from '../../i18n';

export const getStaticPaths = localeStaticParams;

const locale = getLocale(Astro);
const t = useTranslations(locale);

// Structured data for search engines: the website and the photography business behind it.
const homeUrl = new URL(localizePath('/', locale), SITE.url).href;
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: t('site.title'),
    url: homeUrl,
    inLanguage: locale,
    description: t('site.description'),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'ProfessionalService',
    name: t('site.title'),
    url: homeUrl,
    image: new URL('/og-image.png', SITE.url).href,
    description: t('site.description'),
    email: SITE.email,
    address: {
      '@type': 'PostalAddress',
      addressLocality: SITE.address.locality,
      addressRegion: SITE.address.region,
      addressCountry: SITE.address.country,
    },
    contactPoint: {
      '@type': 'ContactPoint',
      email: SITE.email,
      contactType: 'customer service',
      availableLanguage: ['English', 'Spanish'],
    },
    sameAs: Object.values(SITE.social).filter(Boolean),
  },
];

const visibleSlugs = new Set(VISIBLE_CATEGORIES.map((c) => c.slug));

const allPhotos = await getCollection('photos');
const featured = allPhotos
  .filter((p) => p.data.featured && visibleSlugs.has(p.data.category))
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 8);

const sortedCategories = getSortedVisibleCategories(locale);

const covers = sortedCategories.map((category) => {
  const inCategory = allPhotos
    .filter((p) => p.data.category === category.slug)
    .sort((a, b) => a.data.order - b.data.order);
  return { category, cover: inCategory[0] };
});
---

<BaseLayout title={t('site.title')} description={t('site.description')} jsonLd={jsonLd}>
  {locale === DEFAULT_LOCALE && <GeoRedirect />}
  <section class="hero wrap">
    <p class="eyebrow">{t('site.tagline')}</p>
    <h1>{t('home.heroTitle')}</h1>
    <p class="hero-copy">{t('home.heroCopy')}</p>
    <div class="hero-actions">
      <a class="btn btn-primary" href={localizePath('/work/landscape/', locale)}>{t('home.viewWork')}</a>
      <a class="btn" href={localizePath('/contact/', locale)}>{t('home.bookSession')}</a>
    </div>
  </section>

  {featured.length > 0 && (
    <section class="wrap section">
      <h2>{t('home.featured')}</h2>
      <Gallery photos={featured} />
    </section>
  )}

  <section class="wrap section">
    <h2>{t('home.exploreByCategory')}</h2>
    <div class="category-grid">
      {covers.map(({ category, cover }) => (
        <CategoryCard category={category} cover={cover} />
      ))}
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    padding-block: var(--space-5) var(--space-4);
    max-width: 760px;
  }

  .hero h1 {
    font-size: clamp(2rem, 5vw, 3.2rem);
    margin-block: 0.5rem 1rem;
  }

  .hero-copy {
    font-size: 1.05rem;
    max-width: 56ch;
  }

  .hero-actions {
    display: flex;
    gap: var(--space-2);
    margin-top: var(--space-3);
    flex-wrap: wrap;
  }

  .section {
    padding-block: var(--space-4);
  }

  .section h2 {
    margin-bottom: var(--space-3);
    font-size: 1.5rem;
  }

  .category-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: var(--space-3);
  }
</style>
