{
  "name": "photography-site",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "astro dev",
    "prebuild": "node scripts/check-build-env.mjs",
    "build": "astro build",
    "preview": "npm run build && wrangler dev",
    "astro": "astro",
    "prelint": "astro sync",
    "lint": "eslint .",
    "generate-types": "wrangler types",
    "deploy": "npm run build && wrangler deploy && npm run smoke -- --wait",
    "test": "cucumber-js",
    "photos": "node scripts/photos.mjs",
    "photos:add": "node scripts/photos.mjs add",
    "photos:replace": "node scripts/photos.mjs replace",
    "photos:remove": "node scripts/photos.mjs remove",
    "photos:verify": "node scripts/photos.mjs verify",
    "photos:sync": "node scripts/photos.mjs sync",
    "photos:camera": "node scripts/photos.mjs camera",
    "photos:colors": "node scripts/photos.mjs colors",
    "photos:pull": "node scripts/photos.mjs pull",
    "photos:push": "node scripts/photos.mjs push",
    "predeploy": "node scripts/check-build-env.mjs --require && npm test && npm run photos:verify",
    "deploy:unchecked": "npm run build && wrangler deploy",
    "smoke": "node scripts/smoke.mjs",
    "test:browser": "cucumber-js --profile browser",
    "test:record": "node scripts/run-tests.mjs",
    "results": "node scripts/results.mjs",
    "results:publish": "node scripts/results.mjs publish",
    "results:list": "node scripts/results.mjs list",
    "results:show": "node scripts/results.mjs show",
    "results:trend": "node scripts/results.mjs trend",
    "results:prune": "node scripts/results.mjs prune",
    "results-api:dev": "wrangler dev -c workers/results-api/wrangler.jsonc --port 8788",
    "results-api:deploy": "wrangler deploy -c workers/results-api/wrangler.jsonc"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.3.2",
    "@astrojs/sitemap": "^3.7.4",
    "astro": "^7.3.3"
  },
  "allowScripts": {
    "esbuild": true
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@axe-core/playwright": "^4.13.0",
    "@cucumber/cucumber": "^13.2.1",
    "@eslint/js": "^10.0.1",
    "eslint": "^10.11.0",
    "eslint-plugin-astro": "^3.2.1",
    "exifr": "^7.1.3",
    "globals": "^17.12.0",
    "gray-matter": "^4.0.3",
    "html-validate": "^11.16.0",
    "node-html-parser": "^9.0.4",
    "playwright": "^1.63.0",
    "sharp": "^0.35.4",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.1",
    "wrangler": "^4.134.0"
  }
}
