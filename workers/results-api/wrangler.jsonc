{
	// A tiny read-only API over the private test-results bucket, for the Admin page's Test Results tab.
	// Deploy with `npm run results-api:deploy`; set its secret once with
	//   npx wrangler secret put ADMIN_TOKEN -c workers/results-api/wrangler.jsonc
	// (at least 16 characters; the Admin page asks for it). Until the secret exists the API refuses everything.
	"$schema": "../../node_modules/wrangler/config-schema.json",
	"name": "photography-site-results",
	"main": "src/index.mjs",
	"compatibility_date": "2026-09-17",
	"workers_dev": true,
	"r2_buckets": [{ "binding": "RESULTS", "bucket_name": "photography-site-test" }],
	"vars": {
		"ALLOWED_ORIGINS": "https://photography-site.diego-narvaez.workers.dev,http://localhost:4321"
	},
	"observability": { "enabled": true }
}
