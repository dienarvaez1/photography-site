{
	// A tiny read-only API over two private buckets, for the Admin page: the test results (Test Results tab) and the
	// Lighthouse runs (Lighthouse Test Results tab), both in the test bucket, the original photos' metadata (Pics Viewer tab), the site's GitHub issues (GitHub Issues tab), and its access log (Access Info tab).
	// Deploy with `npm run results-api:deploy`; set its secret once with
	//   npx wrangler secret put ADMIN_TOKEN -c workers/results-api/wrangler.jsonc
	// (at least 16 characters; the Admin page asks for it). Until the secret exists the API refuses everything.
	// The GitHub Issues tab reads GITHUB_REPO's issues from GitHub. Optionally, for GitHub's higher rate limit:
	//   npx wrangler secret put GITHUB_TOKEN -c workers/results-api/wrangler.jsonc
	// (a fine-grained token with read-only access to that repository's issues).
	"$schema": "../../node_modules/wrangler/config-schema.json",
	"name": "photography-site-results",
	"main": "src/index.mjs",
	"compatibility_date": "2026-09-17",
	"workers_dev": true,
	"r2_buckets": [
		// results/ (test runs) and lighthouse-results/ (Lighthouse runs): read; runs removed only on the dev box (remove.mjs).
		{ "binding": "RESULTS", "bucket_name": "photography-site-test" },
		// The private originals, for the Pics Viewer (read only: sizes and metadata, never the photo itself).
		{ "binding": "ORIGINALS", "bucket_name": "photography-site-originals" },
		// The site's access log, for the Access Info tab (read only: the site's own Worker writes it).
		{ "binding": "ACCESS", "bucket_name": "photography-site-access" }
	],
	"vars": {
		"ALLOWED_ORIGINS": "https://photography-site.diego-narvaez.workers.dev,https://diego-narvaez-photography.org,http://localhost:4321",
		"GITHUB_REPO": "dienarvaez1/photography-site",
		// Where this Worker runs: production never writes to R2 (removing runs needs SITE_ENV=development, which a local
		// copy on the dev box gets from its .dev.vars, overriding this).
		"SITE_ENV": "production"
	},
	"observability": { "enabled": true }
}
