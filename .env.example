# Copy this file to .env for local development.
# Get a free access key at https://web3forms.com/ (no signup wall, just your email).
# In production (Cloudflare Pages), set these same variables in
# Workers & Pages > your project > Settings > Environment variables.

# Access key for the English contact page (/contact/).
PUBLIC_WEB3FORMS_KEY=

# Access key for the Spanish contact page (/es/contact/) — create a second form in
# Web3Forms so Spanish messages arrive as their own form. Optional: if left empty,
# the Spanish page falls back to PUBLIC_WEB3FORMS_KEY.
PUBLIC_WEB3FORMS_KEY_ES=
